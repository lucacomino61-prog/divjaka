---
/**
 * Home (T3). First screen (DESIGN §6, T2's contract kept): sheet row · poster wordmark DIVJAKA
 * (outline → ink fill) · the line · two ways in · the lagoon plate (LCP). Then:
 * 01 the signature chart "Laguna vizatohet" · 02 Hotel Pelikan · 03 experiences survey strip ·
 * 04 "Rekomanduar për ju" · 05 heritage (the Opal sentence) · 06 today's log · 07 shop · 08 itinerary.
 * The loader runs only here (Base `loader`); the hero photo keeps sizes="100vw" so the loader
 * shares its request.
 */
import Base from '../layouts/Base.astro';
import Wordmark from '../components/site/Wordmark.astro';
import Pill from '../components/site/Pill.astro';
import Photo from '../components/site/Photo.astro';
import Signature from '../components/home/Signature.astro';
import HotelStrip from '../components/home/HotelStrip.astro';
import ExperienceStrip from '../components/home/ExperienceStrip.astro';
import HeritageTeaser from '../components/home/HeritageTeaser.astro';
import LiveTeaser from '../components/home/LiveTeaser.astro';
import ShopTeaser from '../components/home/ShopTeaser.astro';
import ItineraryCta from '../components/home/ItineraryCta.astro';
import RecommendRail from '../components/recommend/RecommendRail.astro';
import { findPhoto, hotelSpot, siteOriginOf } from '../components/site/site-data';
import { t } from '../i18n/ui';
import { path, type Lang } from '../i18n/routes';
import { coords } from '../i18n/format';

interface Props { lang: Lang; params?: Record<string, string>; data?: unknown }
const { lang } = Astro.props;
const spot = await hotelSpot();
// the same pick as the Preloader, so the loader's ring and the hero share one request
const plate = findPhoto(['karavasta', 'lagoon', 'lagun', 'pelican', 'pelikan', 'divjak']);
const origin = await siteOriginOf(Astro.url, Astro.site);

// JSON-LD (added after Base's Hotel + WebSite graph, same @id so the nodes merge). Only
// verified facts: the hotel's setting by the national park and its facilities
// (research/business.json, confidence high). No SearchAction: the site has no search results
// page with a URL to point at (search lives in the assistant and the 404).
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Hotel',
    '@id': `${origin}/#hotel`,
    name: 'Hotel Pelikan',
    amenityFeature: [
      { '@type': 'LocationFeatureSpecification', name: lang === 'sq' ? 'Restorant' : 'Restaurant', value: true },
      { '@type': 'LocationFeatureSpecification', name: lang === 'sq' ? 'Parkim privat falas' : 'Free private parking', value: true },
      { '@type': 'LocationFeatureSpecification', name: lang === 'sq' ? 'Recepsion 24 orë' : '24-hour front desk', value: true },
      { '@type': 'LocationFeatureSpecification', name: lang === 'sq' ? 'Wi-Fi falas' : 'Free Wi-Fi', value: true },
    ],
    containedInPlace: {
      '@type': 'Park',
      name: lang === 'sq' ? 'Parku Kombëtar Divjakë-Karavasta' : 'Divjakë-Karavasta National Park',
      sameAs: 'https://en.wikipedia.org/wiki/Divjak%C3%AB-Karavasta_National_Park',
    },
  },
];
---
<Base lang={lang} title={t(lang, 'page.home.title')} description={t(lang, 'site.description')} routeKey="home" loader jsonld={jsonld} clientKeys={['home.', 'recommend.']}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__sheet">
      <p class="hero__row mono">
        <span>{t(lang, 'home.hero.sheet')}</span>
        <span class="hero__coords">{coords(spot.lat, spot.lon)}</span>
      </p>
      <h1 id="hero-title" class="hero__title">
        <span class="visually-hidden">Divjaka — {t(lang, 'site.hotel')}</span>
        <Wordmark variant="poster" enter class="hero__wordmark" />
      </h1>
      <div class="hero__lead">
        <p class="hero__line">{t(lang, 'site.tagline')}</p>
        <div class="hero__ctas">
          <Pill href={path('stay', lang)} arrow>{t(lang, 'cta.stay')}</Pill>
          <Pill href="#harta" variant="outline">{t(lang, 'cta.chart')}</Pill>
        </div>
      </div>
    </div>
    <div class="hero__plate">
      <Photo slug={plate?.slug ?? 'lagoon-sunset'} lang={lang} sizes="100vw" priority mat={false} parallax>
        <p class="hero__label wrap">
          <span class="water">{t(lang, 'water.lagoon')}</span>
          <span class="hero__label-coords mono">{coords(spot.lat, spot.lon)}</span>
        </p>
      </Photo>
    </div>
  </section>

  <Signature lang={lang} />
  <HotelStrip lang={lang} />
  <ExperienceStrip lang={lang} />
  {/* the strip above already shows every experience and the shop teaser the gift card and the
      chart print: the rail recommends the rest (rooms, packages, gear), as a ruled index */}
  <RecommendRail lang={lang} index="04" kinds={['room', 'bundle', 'goods']} exclude={['harta-e-lagunes']} limit={4} variant="list" lead={t(lang, 'home.rec.lead')} />
  <HeritageTeaser lang={lang} />
  <LiveTeaser lang={lang} />
  <ShopTeaser lang={lang} />
  <ItineraryCta lang={lang} />
</Base>

<script>
  import { initHome } from '../scripts/home';
  initHome();
</script>

<style>
  .hero { display: grid; gap: clamp(20px, 3vw, 40px); padding-block-start: clamp(12px, 2vw, 24px); }
  .hero__sheet { display: grid; gap: clamp(14px, 2vw, 28px); }
  .hero__row { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: var(--step--2); padding-block-start: 10px; border-block-start: 3px solid var(--ink); position: relative; }
  .hero__row::before { content: ""; position: absolute; inset-inline: 0; inset-block-start: 3px; block-size: 1px; background: var(--ink); margin-block-start: 3px; }
  .hero__coords { color: var(--muted); }
  .hero__title { margin: 0; line-height: 0; }
  .hero__wordmark { inline-size: 100%; block-size: auto; color: var(--ink); }
  .hero__lead { display: grid; gap: 20px; align-items: end; }
  .hero__line { font-size: clamp(1.75rem, 1.2rem + 1.6vw, 3rem); font-weight: 600; font-stretch: 85%; font-variation-settings: "opsz" 48; line-height: 1.04; letter-spacing: -0.025em; max-inline-size: 22ch; text-wrap: balance; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (min-width: 900px) {
    .hero__lead { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .hero__ctas { justify-content: flex-end; }
  }
  .hero__plate { position: relative; }
  /* the frame's ratio is set here (Photo's inline style is overridden), phones get 4:3 below */
  .hero__plate :global(.plate__frame) { aspect-ratio: 21 / 9 !important; max-block-size: 70svh; inline-size: 100%; }
  .hero__label { position: absolute; inset-block-end: 16px; inset-inline: 0; pointer-events: none; display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .hero__label .water { background: var(--salt); padding: 2px 10px 4px; font-size: var(--step-2); }
  .hero__label-coords { background: var(--salt); padding: 4px 8px; font-size: var(--step--2); }
  @media (max-width: 599px) {
    .hero__plate :global(.plate__frame) { aspect-ratio: 4 / 3 !important; }
    .hero__label-coords { display: none; }
  }
</style>
