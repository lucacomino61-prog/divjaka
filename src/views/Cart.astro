---
/**
 * Cart (T5) — /shporta/ · /en/cart/. The full cart (the drawer is the quick view): lines priced
 * by POST /api/quote with offers and per-line problems explained, quantity steppers, remove with
 * an inline Undo row, promo code (server-validated), totals in lek (+ ≈ EUR when chosen), the way
 * to the checkout, recommendations and the empty state. The cart lives in this browser
 * (localStorage dv-cart, PLAN §8), so the lines are drawn by scripts/checkout.ts; the server
 * prints the frame, the words and a no-JS note.
 * A product page's form posts here as ?shto=<slug>&sasia=&amount=|vlera=&pas= when its script has
 * not run (a tap before it loaded): the product is looked up here and handed to this page's script
 * in a data island, which adds it. With JavaScript OFF nothing can be added (the cart lives in the
 * browser): the noscript note then names the product and points to the contact page.
 */
import Base from '../layouts/Base.astro';
import SectionHead from '../components/site/SectionHead.astro';
import PermitCard from '../components/site/PermitCard.astro';
import Pill from '../components/site/Pill.astro';
import RecommendRail from '../components/recommend/RecommendRail.astro';
import { findPublished } from '../lib/catalog';
import { pname } from '../lib/db/repo/products';
import { giftLimits } from '../components/shop/shop-data';
import { money } from '../i18n/format';
import '../components/checkout/checkout.css';
import { t } from '../i18n/ui';
import { path, type Lang } from '../i18n/routes';

interface Props { lang: Lang; params?: Record<string, string>; data?: unknown }
const { lang } = Astro.props;

// ?shto=… from a product page's form (no JavaScript there)
const q = Astro.url.searchParams;
let add: Record<string, unknown> | null = null;
// a gift card with no valid value is never added at a value the guest did not choose: the page
// says why and links back to the card
let giftFix: { name: string; url: string; text: string } | null = null;
const shto = (q.get('shto') ?? '').trim().toLowerCase();
if (/^[a-z0-9][a-z0-9-]{0,79}$/.test(shto)) {
  const p = findPublished(shto);
  if (p && p.kind !== 'room' && p.kind !== 'experience') {
    const qty = Math.min(99, Math.max(1, Math.trunc(Number(q.get('sasia')) || 1)));
    const rawAmount = q.get('amount') === 'custom' || !q.get('amount') ? q.get('vlera') : q.get('amount');
    const amount = p.kind === 'gift' ? Math.trunc(Number(String(rawAmount ?? '').replace(/[\s.,]/g, ''))) || null : null;
    const g = p.kind === 'gift' ? giftLimits(p.slug) : null;
    if (g && (!amount || amount < g.min || amount > g.max || (amount - g.min) % g.step !== 0)) {
      giftFix = {
        name: pname(p, lang),
        url: path('product', lang, { slug: p.slug }),
        text: t(lang, 'product.amount.error', { min: money(g.min, lang), max: money(g.max, lang), step: money(g.step, lang) }),
      };
    } else {
      add = { slug: p.slug, kind: p.kind, name: pname(p, lang), qty, amount, buy: q.get('pas') === 'buy' };
    }
  }
}
---
<Base lang={lang} title={t(lang, 'page.cart.title')} description={t(lang, 'page.cart.description')} routeKey="cart" noindex clientKeys={['cartpage.', 'promo.', 'order.promo', 'product.amount', 'recommend.']}>
  {add && <script type="application/json" data-cart-add set:html={JSON.stringify(add).replace(/</g, '\\u003c')} />}

  <section class="wrap cart-head">
    <SectionHead as="h1" index={t(lang, 'cartpage.index')} kicker={t(lang, 'cartpage.kicker')} title={t(lang, 'cart.title')} size="poster">
      <span slot="aside" class="mono cart-head__count" data-count></span>
    </SectionHead>
    <p class="cart-head__lead">{t(lang, 'cartpage.lead')}</p>
    <div class="lastorder" role="status" data-last-order hidden></div>
    {giftFix && (
      <p class="cart-giftfix mono" role="alert">
        {t(lang, 'cartpage.gift.notAdded', { name: giftFix.name })} {giftFix.text}{' '}
        <a href={giftFix.url}>{t(lang, 'cartpage.gift.choose')}</a>
      </p>
    )}
  </section>

  <div class="cart wrap" data-cartpage data-state="loading">
    <div class="cart__main">
      <h2 class="visually-hidden">{t(lang, 'cartpage.lines')}</h2>
      <p class="cart__status mono" role="status" aria-live="polite" data-status></p>
      <p class="visually-hidden" role="status" aria-live="polite" data-say></p>
      <button type="button" class="pill pill--outline pill--s cart__retry" data-retry><span class="pill__main">{t(lang, 'cartpage.retry')}</span></button>
      <p class="cart__problems mono" role="alert" data-problems hidden></p>
      <ul class="clines" data-lines></ul>
      <script is:inline>(function(){try{var c=JSON.parse(localStorage.getItem("dv-cart")||"null");var n=c&&c.v===1&&Array.isArray(c.items)?c.items.length:0;if(document.querySelector("script[data-cart-add]"))n++;var r=document.querySelector("[data-cartpage]");if(r&&!n)r.setAttribute("data-state","empty");document.documentElement.style.setProperty("--cart-n",String(Math.min(n,12)));}catch(e){}})();</script>
      <noscript><p class="cart__noscript">{add ? t(lang, 'cartpage.noscript.add', { name: String(add.name) }) : t(lang, 'cartpage.noscript')}</p></noscript>
      <div class="cart__empty" data-empty>
        <svg class="cart__empty-art" viewBox="0 0 220 120" aria-hidden="true">
          <path d="M4 86 C 50 74, 96 98, 216 78" fill="none" stroke="currentColor" stroke-width="1.25" />
          <path d="M14 98 C 60 88, 110 108, 206 92" fill="none" stroke="currentColor" stroke-width="0.75" opacity=".55" />
          <rect x="74" y="20" width="72" height="46" fill="var(--salt)" stroke="currentColor" stroke-width="1.25" />
          <path d="M74 52h72" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" />
          <path d="M84 32h38M84 40h24" stroke="currentColor" stroke-width="1" />
        </svg>
        <p class="title">{t(lang, 'cartpage.empty.title')}</p>
        <p class="muted cart__empty-body">{t(lang, 'cartpage.empty.body')}</p>
        <div class="cluster">
          <Pill href={path('stay', lang)} arrow>{t(lang, 'cart.empty.stay')}</Pill>
          <Pill href={path('experiences', lang)} variant="outline">{t(lang, 'nav.experiences')}</Pill>
          <Pill href={path('shop', lang)} variant="outline">{t(lang, 'cart.empty.shop')}</Pill>
        </div>
      </div>
    </div>

    <aside class="cart__side" data-side aria-labelledby="cart-sum-h">
      <PermitCard label={t(lang, 'cartpage.summary')} floating class="cart-card">
        <h2 id="cart-sum-h" class="visually-hidden">{t(lang, 'cartpage.summary')}</h2>
        <form class="promo" data-promo novalidate>
          <label class="promo__label mono" for="promo-code">{t(lang, 'promo.label')}</label>
          <div class="promo__row">
            <input id="promo-code" class="promo__input mono" type="text" name="promo" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="40" placeholder={t(lang, 'promo.placeholder')} aria-describedby="promo-msg" />
            <button type="submit" class="pill pill--outline pill--s"><span class="pill__main">{t(lang, 'promo.apply')}</span></button>
          </div>
          <p id="promo-msg" class="promo__msg mono" role="status" aria-live="polite" data-promo-msg></p>
          <button type="button" class="promo__remove mono" data-promo-remove hidden>{t(lang, 'promo.remove')}</button>
        </form>
        <div class="cart-card__sums" data-sums><dl class="sums sums--big sums--sk" aria-hidden="true"><div class="sums__row"><dt class="mono">{t(lang, 'cart.subtotal')}</dt><dd class="mono">—</dd></div><div class="sums__row sums__row--total"><dt class="mono">{t(lang, 'cart.total')}</dt><dd class="sums__total">—</dd></div></dl></div>
        <Fragment slot="stub">
          <p class="mono cart-card__note">{t(lang, 'cart.payNote')}</p>
          <div class="cart-card__actions">
            <p class="cart-card__blocked mono" data-go-note hidden>{t(lang, 'cartpage.go.blocked')}</p>
            <a href={path('checkout', lang)} class="pill pill--primary pill--block" data-go-checkout><span class="pill__main">{t(lang, 'cartpage.checkout')}<svg class="pill__arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></span></a>
            <a href={path('shop', lang)} class="cart-card__more mono">{t(lang, 'cartpage.continue')}</a>
          </div>
        </Fragment>
      </PermitCard>
    </aside>
  </div>

  <RecommendRail lang={lang} id="shporta-rek" index="04.2.1" title={t(lang, 'cartpage.rec')} lead={t(lang, 'cartpage.rec.lead')} limit={4} />
</Base>

<script>
  import { initCartPage } from '../scripts/checkout';
  initCartPage();
</script>

<style>
  .cart-head { padding-block-start: clamp(12px, 2vw, 24px); display: grid; gap: 14px; }
  .cart-head__count { font-size: var(--step--2); display: inline-block; min-block-size: 1lh; min-inline-size: 10ch; text-align: end; white-space: nowrap; }
  .cart-head__lead { max-inline-size: 58ch; color: var(--muted); }
  .cart { display: grid; gap: clamp(24px, 4vw, 56px); margin-block-start: clamp(20px, 3vw, 40px); align-items: start; }
  @media (min-width: 1024px) {
    .cart { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); }
    .cart__side { position: sticky; inset-block-start: calc(var(--header-h) + var(--ticker-h) + 16px); }
  }
  .cart__main { min-inline-size: 0; border-block-start: 2px solid var(--ink); }
  .cart__side { min-inline-size: 0; }
  .cart__side[hidden] { display: none; }
  .cart__status:empty { display: none; }
  .cart__status { padding-block: 14px; font-size: var(--step--2); color: var(--muted); }
  .cart[data-state="error"] .cart__status { color: var(--pouch-text); }
  .cart__retry { display: none; margin-block-end: 14px; }
  .cart[data-state="error"] .cart__retry { display: inline-flex; }
  .cart[data-state="loading"] .clines { opacity: .5; }
  /* errors are logbook slips (as the toast): a 1 px ink rule above and below and one pouch dot */
  .cart__problems { margin-block: 14px 0; padding-block: 12px; border-block: 1px solid var(--ink); font-size: var(--step--1); }
  .cart__problems::before, .cart-giftfix::before { content: ""; display: inline-block; inline-size: 7px; block-size: 7px; border-radius: 99px; background: var(--pouch); margin-inline-end: 10px; vertical-align: 0.1em; }
  .cart__problems[hidden] { display: none; }
  .cart__noscript { padding-block: 20px; }
  .clines { list-style: none; padding: 0; margin: 0; }
  /* reserve the rows the quote will paint (CLS): the inline script counts the stored lines */
  :global(html.js) .clines:empty { min-block-size: calc(var(--cart-n, 0) * var(--cline-h, 159px)); }
  @media (max-width: 520px) { .clines { --cline-h: 130px; } }
  /* an empty cart known before the script: the empty state, no summary card */
  .cart[data-state="empty"] .cart__side { display: none; }
  .cart[data-state="empty"] .cart__empty { display: grid; }
  .cart-giftfix { padding-block: 12px; border-block: 1px solid var(--ink); font-size: var(--step--1); text-transform: none; letter-spacing: 0; }
  .cart-giftfix a { color: var(--pouch-text); text-underline-offset: 3px; display: inline-flex; min-block-size: 44px; align-items: center; }
  .clines :global(.cline) { display: grid; grid-template-columns: 96px minmax(0, 1fr) 44px; gap: 18px; padding-block: 20px; border-block-end: 1px solid var(--rule); align-items: start; }
  .clines :global(.cline__plate) { display: block; inline-size: 88px; aspect-ratio: 4 / 5; margin: 4px; background: var(--salt-2); outline: 1px solid var(--ink); outline-offset: 3px; overflow: clip; }
  .clines :global(.cline__plate img) { inline-size: 100%; block-size: 100%; object-fit: cover; }
  .clines :global(.cline__plate--chart) { color: var(--ink-70); }
  .clines :global(.cline__plate--chart svg) { display: block; inline-size: 100%; block-size: 100%; }
  .clines :global(.cline__body) { display: grid; gap: 6px; min-inline-size: 0; }
  .clines :global(.cline__name) { font-size: var(--step-2); font-weight: 700; font-stretch: 85%; line-height: 1.05; letter-spacing: -0.015em; text-decoration: none; overflow-wrap: anywhere; justify-self: start; }
  .clines :global(a.cline__name:hover) { text-decoration: underline; text-underline-offset: 4px; }
  .clines :global(.cline--gone .cline__name) { color: var(--muted); }
  .clines :global(.cline__meta) { font-size: var(--step--2); color: var(--muted); }
  .clines :global(.cline__offer) { font-size: var(--step--2); color: var(--pouch-text); }
  .clines :global(.cline__problem) { font-size: var(--step--2); color: var(--pouch-text); text-decoration: underline; text-decoration-color: var(--pouch); text-underline-offset: 3px; }
  .clines :global(.cline__fix) { font-size: var(--step--2); justify-self: start; min-block-size: 44px; display: inline-flex; align-items: center; }
  .clines :global(.cline__ctrl) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin-block-start: 8px; }
  .clines :global(.cline__qty) { font-size: var(--step--1); color: var(--muted); }
  .clines :global(.cline__price) { margin-inline-start: auto; text-align: end; font-variant-numeric: tabular-nums; }
  .clines :global(.cline__was) { color: var(--muted); font-size: var(--step--2); margin-inline-end: 6px; }
  .clines :global(.cline__sum) { font-size: var(--step-1); font-weight: 700; font-stretch: 85%; }
  .clines :global(.cline__remove) { inline-size: 44px; block-size: 44px; display: grid; place-items: center; border: 0; background: none; color: var(--muted); cursor: pointer; border-radius: var(--radius-pill); }
  .clines :global(.cline__remove:hover) { color: var(--ink); background: var(--salt-2); }
  .clines :global(.cline-gone) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; padding-block: 18px; border-block-end: 1px solid var(--rule); font-size: var(--step--1); color: var(--muted); }
  @media (max-width: 520px) {
    .clines :global(.cline) { grid-template-columns: 64px minmax(0, 1fr) 44px; gap: 12px; }
    .clines :global(.cline__plate) { inline-size: 56px; }
    .clines :global(.cline__name) { font-size: var(--step-1); }
  }
  /* shown by state (the inline script knows an empty cart before the bundle; chrome.css [hidden] wins over any display) */
  .cart__empty { display: none; justify-items: start; gap: 14px; padding-block: clamp(28px, 5vw, 64px); }
  .cart__empty-art { inline-size: min(220px, 60vw); color: var(--ink); }
  .cart__empty-body { max-inline-size: 48ch; }

  .cart-card :global(.permit__body) { display: grid; gap: 18px; }
  /* the card's single column may shrink below its content's natural width (320–375 px phones) */
  .cart-card :global(.permit__body), .cart-card :global(.permit__stub) { grid-template-columns: minmax(0, 1fr); }
  .cart-card :global(.sums--sk) { color: var(--muted); }
  .promo { display: grid; gap: 6px; }
  .promo__label { font-size: var(--step--2); color: var(--muted); }
  .promo__row { display: flex; gap: 8px; align-items: center; }
  .promo__input { flex: 1 1 0; inline-size: 0; min-inline-size: 0; min-block-size: 48px; font-size: 16px; padding: 0 10px; border: 0; border-block-end: 1px solid var(--ink); background: transparent; color: var(--ink); border-radius: 0; text-transform: uppercase; }
  .promo__input:focus-visible { outline: 2px solid var(--pouch); outline-offset: 2px; }
  .promo__input[aria-invalid="true"] { border-block-end: 2px solid var(--pouch); }
  .promo__row > .pill { flex: none; }
  .promo__msg:empty { display: none; }
  .promo__msg { font-size: var(--step--2); }
  .promo__msg[data-tone="error"] { color: var(--pouch-text); }
  .promo__remove { justify-self: start; min-block-size: 44px; padding: 0; border: 0; background: none; color: inherit; font-size: var(--step--2); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .promo__remove[hidden] { display: none; }
  .cart-card__note { font-size: var(--step--2); color: var(--muted); }
  .cart-card__blocked { font-size: var(--step--2); color: var(--pouch-text); text-transform: none; letter-spacing: .02em; justify-self: stretch; }
  .cart-card__blocked[hidden] { display: none; }
  .cart-card__actions { display: grid; gap: 8px; margin-block-start: 12px; justify-items: center; }
  .cart-card__more { font-size: var(--step--2); min-block-size: 44px; display: inline-flex; align-items: center; text-underline-offset: 3px; }

</style>
