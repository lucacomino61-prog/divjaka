---
/**
 * "Divjaka tani" (/tani/, /en/now/) — T7. The logbook's latest entry (DESIGN §1, §6):
 * temperature in poster figures, the wind drawn on the lagoon chart at the hotel, readings in mono
 * with "përditësuar HH:MM" and the provider beside them, the sun's day as a ruled bar (sunrise,
 * golden hours, dusk — computed here), 24 hours / 7 days, what is in season this month
 * (research/seasons.json, sourced), and today's sessions with places left.
 * Everything is rendered on the server from getLive() (words in the HTML). scripts/live.ts
 * re-fetches this page every 10 minutes while it is visible (paused when hidden or when
 * animations are stopped) and swaps the [data-live-block] sections — no second renderer.
 * Stale or offline: the weather blocks say so and hide their numbers; sun and season stay.
 */
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import Pill from '../components/site/Pill.astro';
import WxGlyph from '../components/live/WxGlyph.astro';
import WindChart from '../components/live/WindChart.astro';
import { getLive, seasonItems, sunTimes, type LivePayload } from '../lib/live';
import { roomsVerified } from '../lib/availability';
import { findPublished } from '../lib/catalog';
import { productUrl } from '../lib/urls';
import { publisherOf } from '../components/heritage/facts';
import { hotelSpot } from '../components/site/site-data';
import { siteOrigin } from '../lib/urls';
import { t } from '../i18n/ui';
import { coords, formatDate, number, tirane } from '../i18n/format';
import { path, type Lang } from '../i18n/routes';

interface Props { lang: Lang; params?: Record<string, string>; data?: unknown }
const { lang } = Astro.props;

// the public origin, also behind the proxy (TRUST_PROXY: x-forwarded-host), for MET's User-Agent
const origin = siteOrigin(Astro.url, Astro.request);
let live: LivePayload | null = null;
try {
  live = await Promise.race([getLive({ origin }), new Promise<null>((r) => setTimeout(() => r(null), 3000))]);
} catch { live = null; }
const w = live && !live.stale ? live.weather : null;
// no reading yet and nothing has failed (a slow provider on a cold start; or getLive itself did not
// answer in time): "loading" and scripts/live.ts asks again in a few seconds, never the stale copy
const loading = !w && (live ? live.loading : true);
const spot = await hotelSpot();
const now = tirane();
const view = Astro.url.searchParams.get('pamja') === 'dite' ? 'days' : 'hours';

/** first letter only: Albanian weekdays are 'E martë', never 'E Martë' */
const cap = (x: string) => x.charAt(0).toUpperCase() + x.slice(1);
const n1 = (v: number) => number(v, lang, Math.abs(v) < 10 && v % 1 !== 0 ? 1 : 0);
const deg = (v: number) => `${Math.round(v)}°`;
const compassIdx = (d: number) => Math.round((((d % 360) + 360) % 360) / 45) % 8;
const compassName = w ? t(lang, `now.compass.${compassIdx(w.wind_dir)}`) : '';
// the time of the last reading (MET checked), never the clock: no reading, no time
const updated = w && live?.updated_at ? tirane(new Date(live.updated_at)).time : '';
const validAt = w ? tirane(new Date(w.valid_at)).time : '';
const weatherSrc = live?.sources.find((s) => s.key === 'weather');
const seaSrc = live?.sources.find((s) => s.key === 'sea');
const airSrc = live?.sources.find((s) => s.key === 'air');
// sun and season do not need the network: when getLive() is slow (cold start), compute them here
// so the promise of the stale text ("the sun and the season below still hold") is kept
const sun = live?.sun ?? sunTimes(now.iso);
const mins = (hm: string) => { const [h, m] = hm.split(':').map(Number); return h * 60 + m; };
const pct = (hm: string) => `${((mins(hm) / 1440) * 100).toFixed(2)}%`;

// 24 hours: sparkline geometry (viewBox 0 0 960 120)
const hours = live && !live.stale ? live.hourly.slice(0, 24) : [];
const tMin = hours.length ? Math.min(...hours.map((h) => h.temp)) : 0;
const tMax = hours.length ? Math.max(...hours.map((h) => h.temp)) : 1;
const span = Math.max(4, tMax - tMin);
const hx = (i: number) => (hours.length > 1 ? (i / (hours.length - 1)) * 960 : 0);
const hy = (v: number) => 104 - ((v - tMin) / span) * 88;
const spark = hours.map((h, i) => `${i ? 'L' : 'M'}${hx(i).toFixed(1)} ${hy(h.temp).toFixed(1)}`).join(' ');

// 7 days: one temperature scale for the whole week
const days = live && !live.stale ? live.daily.slice(0, 7) : [];
const wMin = days.length ? Math.min(...days.map((d) => d.tmin)) : 0;
const wMax = days.length ? Math.max(...days.map((d) => d.tmax)) : 1;
const wSpan = Math.max(6, wMax - wMin);
const bar = (lo: number, hi: number) => `--from:${(((lo - wMin) / wSpan) * 100).toFixed(1)}%;--to:${(((hi - wMin) / wSpan) * 100).toFixed(1)}%`;

const season = live?.season_now.items ?? seasonItems(now.m);
const birdsCal = `${path('article', lang, { slug: 'zogjte-sipas-stineve' })}#muaji-${now.m}`;
const sessions = (live?.availability_today.sessions ?? []).filter((s) => s.left > 0).slice(0, 6);
// free-place counts only for products the owner has verified (demo = 0), the home page's rule: a
// demo schedule's seeded capacity is not a fact (PLAN §2), so it shows its time and name alone
const seatsVerified = new Set(sessions.filter((s) => findPublished(s.slug)?.demo === false).map((s) => s.slug));
// "public domain" in the reader's language; other licence names (CC BY 4.0) stay as they are
const licence = (l: string) => (/^public domain$/i.test(l.trim()) ? t(lang, 'now.license.pd') : l);
// the now-label near midnight sits inside the bar instead of half outside it
const nowM = mins(now.time);
const nowEdge = nowM < 75 ? 'start' : nowM > 1365 ? 'end' : '';
const roomsLeft = live?.availability_today.rooms_verified && roomsVerified() ? live.availability_today.rooms_left : null;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  name: t(lang, 'page.now.title'), description: t(lang, 'page.now.description'),
  url: new URL(path('now', lang), origin).href, inLanguage: lang === 'sq' ? 'sq-AL' : 'en',
  about: { '@type': 'Place', name: 'Divjakë', geo: { '@type': 'GeoCoordinates', latitude: spot.lat, longitude: spot.lon } },
};
---
<Base lang={lang} title={t(lang, 'page.now.title')} description={t(lang, 'page.now.description')} routeKey="now" jsonld={jsonld} clientKeys={['now.']}>
  <div class="now" data-now data-view={view}>
    <section class="wrap now__head" aria-labelledby="now-h" id="now-head">
      <Breadcrumbs lang={lang} items={[{ label: t(lang, 'page.now.title') }]} />
      <p class="now__rule mono">
        <span>{t(lang, 'now.index')}</span>
        <span>{t(lang, 'now.kicker')}</span>
        <span class="now__rule-end">{updated ? <time data-live-block id="now-latest" datetime={updated}>{updated}</time> : <span data-live-block id="now-latest">{t(lang, 'now.latest.none')}</span>} · {coords(spot.lat, spot.lon)}</span>
      </p>

      <div class="now__grid" data-live-block id="now-entry" data-stale={w ? '0' : '1'} data-loading={loading ? '1' : '0'} data-updated={updated}>
        <div class="now__entry">
          <h1 id="now-h" class="now__title">{t(lang, 'now.title')}</h1>
          {w ? (
            <>
              <p class="now__temp">
                <span class="visually-hidden">{t(lang, 'now.temp.aria', { t: String(Math.round(w.temp)) })}</span>
                <span class="now__temp-n" aria-hidden="true">{Math.round(w.temp)}</span><span class="now__temp-u" aria-hidden="true">°C</span>
              </p>
              <p class="now__cond">
                <WxGlyph symbol={w.symbol} size={36} />
                <span class="now__label">{lang === 'sq' ? w.label_sq : w.label_en}<span class="now__label-n mono">{t(lang, 'now.cond.next')}</span></span>
                <span class="now__feels mono">{t(lang, 'now.feels', { t: String(Math.round(w.feels)) })}</span>
              </p>
              <p class="now__stamp mono">
                <span class="live-dot" aria-hidden="true"></span>
                <span>{t(lang, 'now.updated', { time: updated })}</span>
                <span>{t(lang, 'now.valid', { time: validAt })}</span>
                {weatherSrc && <a href={weatherSrc.url} rel="noopener">{lang === 'sq' ? weatherSrc.sq : weatherSrc.en}</a>}
              </p>
            </>
          ) : loading ? (
            <div class="now__stale now__stale--loading" role="status" aria-busy="true">
              <p class="now__stale-t"><span class="live-dot" aria-hidden="true"></span>{t(lang, 'now.loading.title')}</p>
              <p class="muted">{t(lang, 'now.loading.body')}</p>
            </div>
          ) : (
            <div class="now__stale" role="status">
              <p class="now__stale-t">{t(lang, 'now.stale.title')}</p>
              <p class="muted">{t(lang, 'now.stale.body')}</p>
            </div>
          )}
          {w && <p class="now__lead">{t(lang, 'now.lead')}</p>}
        </div>
        <figure class="now__chart">
          <WindChart lang={lang} dir={w?.wind_dir ?? null} kmh={w?.wind_kmh ?? null} compassName={compassName} />
          {w && <figcaption class="now__chart-cap mono">{w.wind_kmh < 3 ? t(lang, 'now.wind.calm') : t(lang, 'now.wind.caption', { dir: compassName, v: String(Math.round(w.wind_kmh)) })}</figcaption>}
        </figure>
      </div>
    </section>

    {w && (
      <section class="wrap now__readings" aria-label={t(lang, 'now.title')} data-live-block id="now-readings">
        <dl class="read">
          <div class="read__c read__c--wide">
            <dt class="mono">{t(lang, 'now.wind')}</dt>
            <dd><span class="read__v">{Math.round(w.wind_kmh)}</span><span class="read__u mono">km/h</span></dd>
            <dd class="read__n mono">{w.wind_kmh < 3 ? t(lang, 'now.wind.calm') : t(lang, 'now.wind.from', { dir: compassName })}{w.gust_kmh != null && ` · ${Math.round(w.gust_kmh)} km/h`}</dd>
          </div>
          <div class="read__c"><dt class="mono">{t(lang, 'now.humidity')}</dt><dd><span class="read__v">{w.humidity}</span><span class="read__u mono">%</span></dd></div>
          {w.cloud != null && <div class="read__c"><dt class="mono">{t(lang, 'now.cloud')}</dt><dd><span class="read__v">{w.cloud}</span><span class="read__u mono">%</span></dd></div>}
          {w.precip_mm != null && <div class="read__c"><dt class="mono">{t(lang, 'now.precip')}</dt><dd><span class="read__v">{n1(w.precip_mm)}</span><span class="read__u mono">mm</span></dd></div>}
          {w.pressure_hpa != null && <div class="read__c"><dt class="mono">{t(lang, 'now.pressure')}</dt><dd><span class="read__v">{number(w.pressure_hpa, lang)}</span><span class="read__u mono">hPa</span></dd></div>}
          {w.uv != null ? (
            <div class="read__c"><dt class="mono">UV</dt><dd><span class="read__v">{n1(w.uv)}</span></dd>{airSrc && <dd class="read__n mono">{lang === 'sq' ? airSrc.sq : airSrc.en}</dd>}</div>
          ) : w.uv_clear_sky != null && w.is_day && (
            <div class="read__c"><dt class="mono">{t(lang, 'now.uv')}</dt><dd><span class="read__v">{n1(w.uv_clear_sky)}</span></dd><dd class="read__n mono">{t(lang, 'now.uv.note')}</dd></div>
          )}
          {live?.marine?.sea_temp != null && (
            <div class="read__c read__c--wide">
              <dt class="mono">{t(lang, 'now.sea')}</dt>
              <dd><span class="read__v">{n1(live.marine.sea_temp)}</span><span class="read__u mono">°C</span></dd>
              {live.marine.sea_date && <dd class="read__n mono">{t(lang, 'now.sea.note', { date: formatDate(live.marine.sea_date, lang, 'day-month') })}{seaSrc && <> · <a href={seaSrc.url} rel="noopener">{lang === 'sq' ? seaSrc.sq : seaSrc.en}</a></>}</dd>}
            </div>
          )}
          {live?.marine?.wave_m != null && <div class="read__c"><dt class="mono">{t(lang, 'now.waves')}</dt><dd><span class="read__v">{n1(live.marine.wave_m)}</span><span class="read__u mono">m</span></dd></div>}
          {live?.air?.aqi != null && <div class="read__c"><dt class="mono">{t(lang, 'now.air')}</dt><dd><span class="read__v">{live.air.aqi}</span></dd>{airSrc && <dd class="read__n mono">{lang === 'sq' ? airSrc.sq : airSrc.en}</dd>}</div>}
        </dl>
      </section>
    )}

    {sun && (
      <section class="now__sun sheet on-ink" aria-labelledby="now-sun-h" data-live-block id="now-sun">
        <div class="wrap">
          <div class="sun__head">
            <h2 id="now-sun-h" class="sun__title">{t(lang, 'now.sun.title')}</h2>
            <p class="sun__len mono">{t(lang, 'now.daylength', { h: String(Math.floor(sun.day_length_min / 60)), m: String(sun.day_length_min % 60) })}</p>
          </div>
          <div class="sun__bar" aria-hidden="true">
            <span class="sun__seg sun__seg--twilight" style={`left:${pct(sun.civil_dawn)};right:calc(100% - ${pct(sun.civil_dusk)})`}></span>
            <span class="sun__seg sun__seg--day" style={`left:${pct(sun.sunrise)};right:calc(100% - ${pct(sun.sunset)})`}></span>
            <span class="sun__seg sun__seg--gold" style={`left:${pct(sun.sunrise)};right:calc(100% - ${pct(sun.golden_morning_end)})`}></span>
            <span class="sun__seg sun__seg--gold" style={`left:${pct(sun.golden_start)};right:calc(100% - ${pct(sun.sunset)})`}></span>
            <span class="sun__now" style={`left:${pct(now.time)}`}></span>
            <span class:list={['sun__now-t mono', nowEdge && `sun__now-t--${nowEdge}`]} style={`left:${pct(now.time)}`}>{now.time}</span>
            {['00:00', '06:00', '12:00', '18:00'].map((h) => <span class:list={['sun__tick mono', h === '00:00' && 'sun__tick--start']} style={`left:${pct(h)}`}>{h.slice(0, 2)}</span>)}
          </div>
          <dl class="sun__list">
            <div><dt class="mono">{t(lang, 'now.sunrise')}</dt><dd>{sun.sunrise}</dd></div>
            <div><dt class="mono">{t(lang, 'now.golden')}</dt><dd class="sun__gold"><span>{t(lang, 'now.golden.morning', { from: sun.sunrise, to: sun.golden_morning_end })}</span><span>{t(lang, 'now.golden.evening', { from: sun.golden_start, to: sun.sunset })}</span></dd></div>
            <div><dt class="mono">{t(lang, 'now.sunset')}</dt><dd>{sun.sunset}</dd></div>
            <div><dt class="mono">{t(lang, 'now.dusk')}</dt><dd>{sun.civil_dusk}</dd></div>
          </dl>
          <p class="sun__note mono">{t(lang, 'now.sun.note')}</p>
        </div>
      </section>
    )}

    {(hours.length > 0 || days.length > 0) && (
      <section class="wrap now__fc sheet" aria-labelledby="now-fc-h" data-live-block id="now-forecast">
        <div class="fc__head">
          <h2 id="now-fc-h" class="fc__title">{t(lang, 'now.forecast.title')}</h2>
          <div class="fc__tabs" role="tablist" aria-label={t(lang, 'now.forecast.title')} data-fc-tabs>
            <a class="fc__tab mono" role="tab" id="fc-tab-hours" href="?pamja=ore" aria-controls="fc-hours" aria-selected={view === 'hours' ? 'true' : 'false'} data-tab="hours">{t(lang, 'now.tab.hours')}</a>
            <a class="fc__tab mono" role="tab" id="fc-tab-days" href="?pamja=dite" aria-controls="fc-days" aria-selected={view === 'days' ? 'true' : 'false'} data-tab="days">{t(lang, 'now.tab.days')}</a>
          </div>
        </div>

        {hours.length > 0 && (
          <div class="fc__panel" id="fc-hours" role="tabpanel" aria-labelledby="fc-tab-hours" data-panel="hours">
            <div class="hours" data-lenis-prevent tabindex="0" role="region" aria-label={t(lang, 'now.hours.caption')}>
              <div class="hours__in" style={`--n:${hours.length}`}>
                <svg class="hours__spark" viewBox="0 0 960 120" preserveAspectRatio="none" aria-hidden="true">
                  {[0.25, 0.5, 0.75].map((f) => <path d={`M0 ${(16 + f * 88).toFixed(0)}H960`} class="hours__grid" />)}
                  <path d={spark} class="hours__line" />
                  <circle cx={hx(0).toFixed(1)} cy={hy(hours[0].temp).toFixed(1)} r="4" class="hours__now" />
                </svg>
                <ol class="hours__cols">
                  {hours.map((h, i) => (
                    <li class:list={['hours__c', i === 0 && 'is-now']}>
                      <span class="hours__t mono">{i === 0 ? t(lang, 'live.now') : h.time}</span>
                      <WxGlyph symbol={h.symbol} size={24} />
                      <span class="hours__v">{deg(h.temp)}</span>
                      <span class="hours__w mono">{Math.round(h.wind_kmh)}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
            <p class="fc__note mono">{t(lang, 'now.hours.caption')} · °C · {t(lang, 'now.wind').toLowerCase()} km/h</p>
          </div>
        )}

        {days.length > 0 && (
          <div class="fc__panel" id="fc-days" role="tabpanel" aria-labelledby="fc-tab-days" data-panel="days">
            <ol class="days">
              {days.map((d, i) => (
                <li class="days__r">
                  <span class="days__d">
                    <span class="days__name">{i === 0 ? t(lang, 'now.days.today') : cap(formatDate(d.date, lang, 'weekday'))}</span>
                    <span class="days__date mono">{i === 0 ? t(lang, 'now.days.today.note') : formatDate(d.date, lang, 'short')}</span>
                  </span>
                  <WxGlyph symbol={d.symbol} size={30} />
                  <span class="days__label">{lang === 'sq' ? d.label_sq : d.label_en}</span>
                  <span class="days__range" role="img" aria-label={`${t(lang, 'now.days.min')} ${deg(d.tmin)}, ${t(lang, 'now.days.max')} ${deg(d.tmax)}`}>
                    <span class="days__lo mono">{deg(d.tmin)}</span>
                    <span class="days__track" aria-hidden="true"><span class="days__bar" style={bar(d.tmin, d.tmax)}></span></span>
                    <span class="days__hi mono">{deg(d.tmax)}</span>
                  </span>
                  <span class="days__meta mono">
                    <span>{t(lang, 'now.days.wind', { v: String(Math.round(d.wind_max)) })}</span>
                    <span>{d.precip_mm != null && d.precip_mm >= 0.1 ? t(lang, 'now.days.rain', { v: n1(d.precip_mm) }) : t(lang, 'now.days.dry')}</span>
                    {d.sunrise && d.sunset && <span>↑{d.sunrise} ↓{d.sunset}</span>}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        )}
      </section>
    )}

    <section class="wrap now__duo sheet" data-live-block id="now-park">
      <div class="duo__col" aria-labelledby="now-season-h">
        <p class="duo__rule mono"><span id="now-season-h">{t(lang, 'now.season.title')}</span><a href={birdsCal}>{t(lang, 'now.season.more')}</a></p>
        <p class="duo__lead">{t(lang, 'now.season.lead')}</p>
        {season.length ? (
          <ul class="season">
            {season.map((s) => (
              <li class="season__i">
                <p>{lang === 'sq' ? s.sq : s.en}</p>
                <a class="season__src mono" href={s.source_url} rel="noopener">{publisherOf(s.source_url)}</a>
              </li>
            ))}
          </ul>
        ) : <p class="muted">{t(lang, 'now.season.empty')}</p>}
      </div>
      <div class="duo__col" aria-labelledby="now-today-h">
        <p class="duo__rule mono"><span id="now-today-h">{t(lang, 'now.today.title')}</span><a href={path('experiences', lang)}>{t(lang, 'now.today.all')}</a></p>
        <p class="duo__lead">{t(lang, 'now.today.lead')}</p>
        {roomsLeft != null && roomsLeft > 0 && <p class="today__rooms"><a href={path('stay', lang)}>{t(lang, 'now.rooms', { n: String(roomsLeft) })}</a></p>}
        {sessions.length ? (
          <ul class="today">
            {sessions.map((s) => (
              <li><a href={productUrl('experience', s.slug, lang)} class="today__a">
                <span class="today__t mono">{s.starts_at.slice(11, 16)}</span>
                <span class="today__n">{lang === 'sq' ? s.name_sq : s.name_en}</span>
                {seatsVerified.has(s.slug) && <span class="today__s mono">{s.left === 1 ? t(lang, 'now.today.seat') : t(lang, 'now.today.seats', { n: String(s.left) })}</span>}
              </a></li>
            ))}
          </ul>
        ) : <p class="muted today__empty">{t(lang, 'now.today.empty')}</p>}
        <div class="today__plan">
          <p class="today__plan-t">{t(lang, 'now.plan.title')}</p>
          <p class="muted">{t(lang, 'now.plan.body')}</p>
          <Pill href={path('itinerary', lang)} arrow>{t(lang, 'now.plan.cta')}</Pill>
        </div>
      </div>
    </section>

    <section class="wrap now__foot" aria-labelledby="now-src-h">
      <div class="foot__bar">
        <p class="foot__status mono" data-now-status role="status" aria-live="polite"></p>
        <p class="foot__auto mono" data-now-auto>{t(lang, 'now.auto')}</p>
        <button type="button" class="pill pill--outline pill--s" data-now-refresh>{t(lang, 'now.refresh')}</button>
      </div>
      <h2 id="now-src-h" class="foot__h mono">{t(lang, 'now.sources.title')}</h2>
      <ol class="foot__src" data-live-block id="now-sources">
        {(live?.sources ?? []).map((s) => (
          <li><a href={s.url} rel="noopener">{lang === 'sq' ? s.sq : s.en}</a> <span class="mono muted">· <a href={s.license_url} rel="noopener license">{t(lang, 'now.license', { l: licence(s.license) })}</a></span></li>
        ))}
        <li class="muted">{t(lang, 'now.sources.rounded')}</li>
      </ol>
    </section>
  </div>
</Base>

<style>
  .now__head { padding-block-start: clamp(16px, 2vw, 28px); }
  .now__rule { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: var(--step--2); padding-block: 10px; border-block-start: 3px double var(--ink); margin-block-start: 18px; }
  .now__rule-end { margin-inline-start: auto; }
  .now__grid { display: grid; gap: clamp(24px, 4vw, 56px); margin-block-start: clamp(12px, 2vw, 24px); }
  @media (min-width: 960px) { .now__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: start; } }
  .now__entry { display: grid; gap: 14px; align-content: start; min-inline-size: 0; }
  .now__title { font-size: var(--step-4); font-weight: 700; font-stretch: 85%; line-height: 1; letter-spacing: -0.02em; overflow-wrap: anywhere; }
