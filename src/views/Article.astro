---
/**
 * Article — one heritage sheet (/trashegimia/[slug]/). Poster title, lead, meta row (sheet
 * number, reading time, number of sources, date), the hero plate (LCP), the body (prose with
 * numbered source marks, plates, mini charts, the month table or the distance table) beside a
 * sticky rail with the sheet's places on the chart and related experiences; then the sources and
 * the previous / next sheet. JSON-LD: Article, plus TouristAttraction (with geo only where the
 * position is known) for sheets about one place.
 */
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import Photo from '../components/site/Photo.astro';
import SourceList from '../components/site/SourceList.astro';
import Chart from '../components/chart/Chart.astro';
import SeasonsTable from '../components/heritage/SeasonsTable.astro';
import DistancesTable from '../components/heritage/DistancesTable.astro';
import RelatedCards from '../components/heritage/RelatedCards.astro';
import { fromHotelKm, kmLabel, layers, poi, unproject } from '../components/chart/geo';
import { getPhoto, siteOriginOf } from '../components/site/site-data';
import { photoSrc } from '../components/site/photo-url';
import { t } from '../i18n/ui';
import { formatDate } from '../i18n/format';
import { path, type Lang } from '../i18n/routes';
import type { ArticleData } from './article.load';
import { posterEm, posterLayout } from '../assets/poster-metrics';

interface Props { lang: Lang; params?: Record<string, string>; data?: ArticleData }
const { lang, params = {}, data } = Astro.props;
const d = data!;
const s = d.sheet;
const origin = await siteOriginOf(Astro.url, Astro.site);
const url = new URL(path('article', lang, { slug: s.slug }), origin).href;
const hero = getPhoto(s.hero);
// a distance only to the sheet's own place, when that is a real, visitable point of geo.json
// (never a chart spot we placed, a closed zone or an area), and it says which point it is
const placePoi = s.place ? poi(s.place) : undefined;
const CLOSED = new Set(['pelican-island', 'pelican-tower']);
const km = placePoi && !placePoi.virtual && !CLOSED.has(placePoi.id) && placePoi.id !== 'hotel-pelikan' ? fromHotelKm(placePoi.id) : null;

// the title as a poster capped at two lines (a one-word title keeps the full poster fit), so the
// lead, the meta row and the hero reach the first screen
const words = s.title.split(/\s+/).filter(Boolean);
let poster = posterLayout(s.title);
if (words.length > 1) {
  let floor = posterEm(s.title) / 2;
  poster = posterLayout(s.title, floor);
  while (poster.lines.length > 2 && floor < 40) { floor *= 1.06; poster = posterLayout(s.title, floor); }
}

// the place this sheet is about (JSON-LD)
const L = layers();
const PLACES: Record<string, () => Record<string, unknown> | null> = {
  lagoon: () => {
    const c = L ? unproject(L.lagoonCentre.x, L.lagoonCentre.y) : null;
    return { '@type': ['TouristAttraction', 'BodyOfWater'], name: t(lang, 'water.lagoon'), sameAs: 'https://en.wikipedia.org/wiki/Karavasta_Lagoon', ...(c ? { geo: { '@type': 'GeoCoordinates', latitude: Number(c.lat.toFixed(4)), longitude: Number(c.lon.toFixed(4)) } } : {}) };
  },
  // closed to visitors: a place, not an attraction
  'pelican-island': () => ({ '@type': ['Place', 'Landform'], name: lang === 'sq' ? 'Ishulli i Pelikanit' : 'Pelican Island', sameAs: 'https://en.wikipedia.org/wiki/Pelican_Island_(Albania)', publicAccess: false }),
  // no geo: our chart spot inside the forest polygon is not the forest's coordinates
  'pine-forest': () => ({ '@type': ['TouristAttraction', 'Landform'], name: lang === 'sq' ? 'Pylli me pisha i Divjakës' : 'Divjaka coastal pine forest' }),
  'visitor-centre': () => {
    const p = poi('visitor-centre');
    return { '@type': ['TouristAttraction', 'Park'], name: lang === 'sq' ? 'Parku Kombëtar Divjakë-Karavasta' : 'Divjakë-Karavasta National Park', sameAs: 'https://en.wikipedia.org/wiki/Divjak%C3%AB-Karavasta_National_Park', ...(p ? { geo: { '@type': 'GeoCoordinates', latitude: p.lat, longitude: p.lon } } : {}) };
  },
};
const place = s.place && PLACES[s.place] ? PLACES[s.place]() : null;
const jsonld = [
  {
    '@context': 'https://schema.org', '@type': 'Article', '@id': `${url}#article`,
    headline: s.title, description: s.description, inLanguage: lang === 'sq' ? 'sq-AL' : 'en',
    mainEntityOfPage: url, ...(s.updated ? { dateModified: s.updated, datePublished: s.updated } : {}),
    ...(hero ? { image: new URL(photoSrc(hero.slug, 1280, 'webp'), origin).href } : {}),
    author: { '@id': `${origin}/#hotel` }, publisher: { '@id': `${origin}/#hotel` },
    isPartOf: { '@type': 'CollectionPage', name: t(lang, 'page.heritage.title'), url: new URL(path('heritage', lang), origin).href },
    citation: d.sources.slice(0, 30).map((x) => x.url),
    ...(place ? { about: { '@context': 'https://schema.org', ...place } } : {}),
  },
];
// on phones the rail stacks under the body: a body that already shows the chart skips the rail's copy
const inlineChart = d.blocks.some((b) => b.type === 'chart');
const nums = (n: number) => String(n).padStart(2, '0');
---
<Base lang={lang} title={`${s.title} · ${t(lang, 'article.crumb')}`} description={s.description} routeKey="article" params={params} jsonld={jsonld} image={hero ? photoSrc(hero.slug, 1280, 'webp') : undefined}>
  <article class="art">
    <header class="wrap art__head">
      <Breadcrumbs lang={lang} items={[{ label: t(lang, 'article.crumb'), href: path('heritage', lang) }, { label: s.title }]} />
      <div class="section-head section-head--poster">
        <p class="section-head__rule mono"><span class="section-head__index">{t(lang, 'heritage.sheet', { n: nums(d.index) })}</span>{s.kicker && <span class="section-head__kicker">{s.kicker}</span>}</p>
        {/* desktop: the poster, lead and meta on the left, the hero plate (LCP) beside them */}
        <div class="art__split">
          <div class="art__left">
            <div class="poster-wrap">
              <h1 class="poster section-head__title art__title" style={`--fit-em:${poster.fitEm.toFixed(3)};--poster-fb:"Poster Fallback ${poster.fallback}"`}>{poster.lines.map((l, i) => <Fragment>{i > 0 ? ' ' : ''}<span class="poster__line">{l}</span></Fragment>)}</h1>
            </div>
            <div class="art__lead-row">
              <p class="lede art__lead">{s.description}</p>
              <p class="art__meta mono">
                <span>{t(lang, 'heritage.minutes', { n: String(s.minutes) })}</span>
                <span>{t(lang, 'heritage.sourcesCount', { n: String(d.sources.length) })}</span>
                {s.updated && <span>{t(lang, 'heritage.updated', { date: formatDate(s.updated, lang, 'medium') })}</span>}
                {km != null && placePoi && <span>{t(lang, 'article.fromHotelTo', { km: kmLabel(km, lang), place: placePoi.name[lang] })}</span>}
              </p>
            </div>
          </div>
          {hero && (
            <div class="art__hero" style={s.heroFocus ? `--hero-focus:${s.heroFocus}` : undefined}>
              <Photo slug={hero.slug} lang={lang} sizes="(min-width: 1100px) calc((100vh - 286px) * 0.8), 100vw" priority caption parallax ratio="16 / 9" />
            </div>
          )}
        </div>
      </div>
    </header>

    <div class="wrap art__grid">
      <div class="art__body">
        {d.blocks.map((b) => {
          if (b.type === 'p') return <p class="art__p" set:html={b.html} />;
          if (b.type === 'h2') return <h2 id={b.id} class="art__h2" set:html={b.html} />;
          if (b.type === 'ul') return <ul class="art__ul">{b.items.map((i) => <li set:html={i} />)}</ul>;
          if (b.type === 'photo') return (
            <div class="art__plate">
              <Photo slug={b.slug} lang={lang} caption sizes="(min-width: 900px) 60vw, 100vw" reveal />
              {b.note && <p class="art__note mono"><span>{t(lang, 'article.photoNote')}:</span> {b.note}</p>}
            </div>
          );
          if (b.type === 'chart') return (
            <div class="art__chart">
              <Chart lang={lang} mode="pin" pins={b.pins.map((p) => ({ id: p.id, zone: p.zone, tag: 'name' as const }))} />
            </div>
          );
          if (b.type === 'seasons') return <SeasonsTable lang={lang} />;
          if (b.type === 'distances') return <DistancesTable lang={lang} />;
          return null;
        })}
      </div>

      <aside class="art__rail" aria-label={t(lang, 'article.related')}>
        {d.pins.length > 0 && (
          <section class:list={['art__rail-block', inlineChart && 'art__rail-block--wide-only']}>
            <h2 class="art__rail-h mono">{t(lang, 'article.onChart')}</h2>
            <Chart lang={lang} mode="pin" pins={d.pins.map((p) => ({ id: p.id, zone: p.zone, tag: 'name' as const }))} />
          </section>
        )}
        {d.related.length > 0 && (
          <section class="art__rail-block">
            <h2 class="art__rail-h mono">{t(lang, 'article.related')}</h2>
            <p class="art__rail-lead">{t(lang, 'article.related.lead')}</p>
            <RelatedCards lang={lang} items={d.related} />
          </section>
        )}
      </aside>
    </div>

    <div class="wrap art__sources">
      <p class="art__sources-note">{t(lang, 'article.sourcesNote')}</p>
      <SourceList lang={lang} items={d.sources} id="burimet" />
    </div>

    <nav class="wrap art__pager" aria-label={t(lang, 'heritage.list.title')}>
      {d.prev ? (
        <a href={path('article', lang, { slug: d.prev.slug })} class="art__pg art__pg--prev">
          <span class="mono">← {t(lang, 'article.prev')}</span><span class="art__pg-t">{d.prev.title}</span>
        </a>
      ) : <span></span>}
      <a href={path('heritage', lang)} class="art__all mono">{t(lang, 'article.all')} · {nums(d.total)}</a>
      {d.next ? (
        <a href={path('article', lang, { slug: d.next.slug })} class="art__pg art__pg--next">
          <span class="mono">{t(lang, 'article.next')} →</span><span class="art__pg-t">{d.next.title}</span>
        </a>
      ) : <span></span>}
    </nav>
  </article>
</Base>

<style>
  .art__head { padding-block-start: clamp(16px, 2vw, 28px); display: grid; gap: 18px; }
  /* poster size on phones too: two lines fill the column (the fit still caps each line to the width) */
  .art__title { --poster-max: clamp(5rem, 1rem + 26vw, 11rem); }
  .art__split { display: grid; gap: 0 clamp(32px, 4vw, 64px); }
  .art__lead-row { display: grid; gap: 18px; align-items: end; padding-block: 18px clamp(20px, 3vw, 40px); }
  .art__lead { max-inline-size: 36ch; }
  .art__meta { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: var(--step--2); color: var(--muted); }
  @media (min-width: 900px) { .art__lead-row { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } .art__meta { justify-content: flex-end; } }
  .art__hero { margin-block-end: clamp(32px, 5vw, 72px); min-inline-size: 0; }
  /* wide screens: the sheet's first screen is poster + lead on the left and a tall plate on the right */
  @media (min-width: 1100px) {
    .art__split { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: start; padding-block-start: 14px; container-type: inline-size; }
    /* the poster at the top, lead + meta set on the hero's foot line: one composed first screen */
    .art__split:has(.art__hero) .art__left { display: flex; flex-direction: column; justify-content: space-between; gap: 24px; /* = the hero frame: 4:5 of the 5fr column, capped like the frame */
      min-block-size: min(calc(100svh - var(--header-h) - 190px), calc((100cqi - clamp(32px, 4vw, 64px)) * 5 / 12 * 1.25)); }
    .art__left .art__lead-row { padding-block-end: 0; }
    .art__split .art__lead-row { grid-template-columns: minmax(0, 1fr); }
    .art__split .art__meta { justify-content: flex-start; }
    .art__hero :global(.plate__frame) { aspect-ratio: 4 / 5 !important; max-block-size: calc(100svh - var(--header-h) - 190px) !important; }
  }
  .art__hero :global(.plate__frame) { max-block-size: 72svh; }
  /* a sheet may say where its wide crop sits (frontmatter hero_focus), e.g. the pelicans at the foot of the frame */
  .art__hero[style] :global(.plate__frame img) { object-position: var(--hero-focus) !important; }
  .art__grid { display: grid; gap: clamp(40px, 6vw, 96px); }
  @media (min-width: 1000px) { .art__grid { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); align-items: start; } }
  .art__body { min-inline-size: 0; }
  .art__body > :global(* + *) { margin-block-start: 1.1em; }
  .art__p { max-inline-size: 66ch; font-size: var(--step-0); line-height: 1.6; }
  .art__p:first-child { font-size: var(--step-1); line-height: 1.45; max-inline-size: 52ch; }
  .art__h2 { font-size: var(--step-3); margin-block-start: 1.8em !important; padding-block-start: 12px; border-block-start: 2px solid var(--ink); max-inline-size: 26ch; scroll-margin-block-start: calc(var(--header-h) + 24px); }
  .art__ul { padding-inline-start: 0; list-style: none; max-inline-size: 66ch; display: grid; gap: 10px; }
  .art__ul li { padding-inline-start: 22px; position: relative; line-height: 1.55; }
  .art__ul li::before { content: ""; position: absolute; inset-inline-start: 2px; inset-block-start: 0.7em; inline-size: 9px; block-size: 1px; background: var(--ink); }
  .art__body :global(sup.ref) { font-family: var(--font-mono); font-size: 0.66em; line-height: 0; margin-inline-start: 2px; }
  .art__body :global(sup.ref a) { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px; padding: 0 2px; display: inline-block; min-inline-size: 24px; min-block-size: 24px; line-height: 24px; text-align: center; }
    /* the hit area reaches 15 px past the mark: less than the 16 px page gutter, so a mark at a line end never widens the page */
  /* vertical padding stays inside the line ((line-height − 14 px) / 2), so a mark never takes the taps of a link on the line above or below; 24 px tall, wide sideways */
  @media (pointer: coarse) { .art__body :global(sup.ref a) { padding: 5px 15px; margin: -5px -15px; box-sizing: content-box; min-inline-size: 14px; min-block-size: 14px; line-height: 14px; } }
  .art__body :global(em) { font-family: var(--font-serif); font-style: italic; font-size: 1.08em; }
  .art__plate { margin-block: 2em !important; }
  .art__note { font-size: var(--step--2); margin-block-start: 6px; text-transform: none; letter-spacing: 0; color: var(--muted); }
  .art__chart { max-inline-size: 560px; margin-block: 2em !important; }
  .art__rail { display: grid; gap: 40px; }
  @media (min-width: 1000px) { .art__rail { position: sticky; inset-block-start: calc(var(--header-h) + 24px); max-block-size: calc(100svh - var(--header-h) - 48px); overflow: auto; overscroll-behavior: contain; scrollbar-width: thin; } }
  .art__rail-block { display: grid; gap: 12px; }
  @media (max-width: 999px) { .art__rail-block--wide-only { display: none; } }
  .art__rail-h { font-size: var(--step--2); padding-block: 10px 0; border-block-start: 2px solid var(--ink); }
  .art__rail-lead { color: var(--muted); font-size: var(--step--1); }
  .art__sources { padding-block: clamp(48px, 7vw, 96px) 0; display: grid; gap: 16px; }
  .art__sources-note { color: var(--muted); max-inline-size: 66ch; font-size: var(--step--1); }
  .art__pager { display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px; align-items: end; padding-block: clamp(40px, 6vw, 80px); border-block-end: 1px solid var(--rule); }
  .art__pg { display: grid; gap: 6px; text-decoration: none; min-block-size: 44px; }
  .art__pg .mono { font-size: var(--step--2); color: var(--muted); }
  .art__pg-t { font-size: var(--step-2); font-weight: 700; font-stretch: 85%; line-height: 1.05; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .art__pg--next { text-align: end; }
  .art__all { font-size: var(--step--2); align-self: center; min-block-size: 44px; display: inline-flex; align-items: center; }
  @media (max-width: 699px) { .art__pager { grid-template-columns: 1fr; } .art__pg--next { text-align: start; } .art__all { order: 3; } }
</style>
