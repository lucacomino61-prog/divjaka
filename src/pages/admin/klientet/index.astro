---
/** /admin/klientet/ — Klientët (T6): search, marketing filter, order counts and confirmed revenue, CSV export (owner). */
import Admin from '../../../layouts/Admin.astro';
import Badge from '../../../components/admin/Badge.astro';
import Stamp from '../../../components/site/Stamp.astro';
import { adminLang, tr, lek, when, pageOf, withParam } from '../../../components/admin/admin-data';
import { listCustomers } from '../../../lib/db/repo/customers';

const lang = adminLang(Astro);
const notFound = (Astro.url.searchParams.get('notfound') ?? '').slice(0, 40);
const T = tr(lang);
const owner = (Astro.locals.admin as { role: string } | null)?.role === 'owner';
const sp = Astro.url.searchParams;
const q = (sp.get('q') ?? '').slice(0, 100);
const consent = sp.get('consent') === '1';
const limit = 50;
const offset = Math.max(0, Number(sp.get('offset')) || 0);
const data = listCustomers({ q: q || undefined, consent, limit, offset });
const pg = pageOf(data.total, offset, limit);
---
<Admin lang={lang} title={T('admin.customers.title')} section="customers" kicker={T('admin.customers.kicker')}>
  {notFound && <p class="note-box" role="status" style="margin-block-end:24px">{T('admin.notfound.customer', { id: notFound })}</p>}
  <Fragment slot="actions">
    {owner && <a class="pill pill--outline pill--s" href="/api/admin/customers/export" download>{T('admin.customers.export')}</a>}
    {owner && <a class="pill pill--outline pill--s" href="/api/admin/customers/export?consent=1" download>{T('admin.customers.export.marketing')}</a>}
  </Fragment>
  {owner && <p class="fld__help" style="margin-block-end:16px">{T('admin.customers.export.help')}</p>}
  <form class="filters" method="get" action="/admin/klientet/" role="search" data-autosubmit>
    <div class="fields">
      <div class="fld span-2"><label class="fld__label mono" for="c-q">{T('admin.search')}</label><input id="c-q" class="fld__input" type="search" name="q" value={q} placeholder={T('admin.customers.q')} /></div>
      <label class="fld fld--check" style="align-self:end"><input class="check" type="checkbox" name="consent" value="1" checked={consent} /><span class="fld__label">{T('admin.customers.consent')}</span></label>
    </div>
    <div class="form-actions">
      <button class="pill pill--primary pill--s" type="submit">{T('admin.filter')}</button>
      {(q || consent) && <a class="btn-text" href="/admin/klientet/">{T('admin.filter.clear')}</a>}
      <span class="pager__info mono">{T('admin.showing', { from: pg.from, to: pg.to, total: pg.total })}</span>
    </div>
  </form>
  {data.items.length ? (
    <div class="table-scroll">
      <table class="adm-table adm-table--stack">
        <thead><tr><th scope="col">{T('admin.customer.name')}</th><th scope="col">{T('admin.customer.phone')}</th><th scope="col" class="num">{T('admin.customers.orders')}</th><th scope="col" class="num">{T('admin.customers.revenue')}</th><th scope="col">{T('admin.customers.last')}</th><th scope="col">{T('admin.customers.marketing')}</th></tr></thead>
        <tbody>
          {data.items.map((c) => (
            <tr>
              <td data-label="" class="cell-wide"><a class="rowlink" href={`/admin/klientet/${c.id}/`}>{c.name || c.email}</a><span class="cell-sub break">{c.email}{c.country ? ` · ${c.country}` : ''}</span></td>
              <td data-label={T('admin.customer.phone')} class="mono" style="font-size:12px">{c.phone || '—'}</td>
              <td data-label={T('admin.customers.orders')} class="num mono">{c.orders}</td>
              <td data-label={T('admin.customers.revenue')} class="num mono">{lek(c.revenue, lang)}</td>
              <td data-label={T('admin.customers.last')} class="mono when" style="font-size:11.5px">{when(c.last_order, lang)}</td>
              <td data-label={T('admin.customers.marketing')}><span class="badges">{c.marketing_consent ? <Badge>{T('admin.yes')}</Badge> : <Badge tone="muted">{T('admin.no')}</Badge>}{!!c.demo && <Stamp kind="demo" lang={lang} tone="ink" tilt={false} />}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : <p class="adm-empty mono">{T('admin.customers.none')}</p>}
  <nav class="pager" aria-label={T('admin.page')}>
    {pg.prev !== null && <a class="pill pill--outline pill--s" href={withParam(Astro.url, { offset: pg.prev || null })}>← {T('admin.prev')}</a>}
    {pg.next !== null && <a class="pill pill--outline pill--s" href={withParam(Astro.url, { offset: pg.next })}>{T('admin.next')} →</a>}
  </nav>
</Admin>
