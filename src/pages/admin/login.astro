---
/** /admin/login — sign-in (T6). Already signed in → straight to `next` (validated: /admin paths only). */
import Admin from '../../layouts/Admin.astro';
import Wordmark from '../../components/site/Wordmark.astro';
import { adminLang } from '../../components/admin/admin-data';
import { t } from '../../i18n/ui';
import { coords } from '../../i18n/format';
import { hotelSpot } from '../../components/site/site-data';

const lang = adminLang(Astro);
const raw = Astro.url.searchParams.get('next') ?? '';
// Only same-site admin paths: no scheme, no protocol-relative //host, no backslashes.
const next = /^\/admin(?:[/?#]|$)/.test(raw) && !/^\/\/|\\/.test(raw) && !raw.startsWith('/admin/login') ? raw : '/admin/';
if (Astro.locals.admin) return Astro.redirect(next, 303);
const spot = await hotelSpot();
---
<Admin lang={lang} title={t(lang, 'admin.login.title')} bare>
  <div class="login">
    <section class="login__sheet on-ink" aria-hidden="true">
      <p class="mono muted">{t(lang, 'admin.brand.sub')}</p>
      <div class="login__poster"><Wordmark variant="solid" /></div>
      <p class="mono muted">Hotel Pelikan · {coords(spot.lat, spot.lon)}</p>
    </section>
    <form class="login__form" id="login" data-next={next} novalidate>
      <div class="vstack">
        <p class="mono muted">{t(lang, 'admin.title')}</p>
        <h1 class="adm-title adm-title--s">{t(lang, 'admin.login.title')}</h1>
        <p class="muted">{t(lang, 'admin.login.lede')}</p>
      </div>
      <div class="fld">
        <label class="fld__label mono" for="login-email">{t(lang, 'admin.login.email')}</label>
        <input id="login-email" class="fld__input" type="email" name="email" autocomplete="username" required inputmode="email" autocapitalize="off" spellcheck="false" />
      </div>
      <div class="fld">
        <label class="fld__label mono" for="login-pw">{t(lang, 'admin.login.password')}</label>
        <div class="pw">
          <input id="login-pw" class="fld__input" type="password" name="password" autocomplete="current-password" required />
          <button type="button" class="pw__toggle" data-pw-toggle aria-controls="login-pw" aria-label={t(lang, 'admin.login.show.aria')} data-show={t(lang, 'admin.login.show')} data-hide={t(lang, 'admin.login.hide')} data-show-aria={t(lang, 'admin.login.show.aria')} data-hide-aria={t(lang, 'admin.login.hide.aria')}>{t(lang, 'admin.login.show')}</button>
        </div>
      </div>
      <p class="form-status" data-form-status role="alert"></p>
      <div class="form-actions">
        <button class="pill pill--primary" type="submit">{t(lang, 'admin.login.submit')}</button>
        <button type="button" class="adm-link mono" data-admin-lang-toggle={lang === 'sq' ? 'en' : 'sq'} lang={lang === 'sq' ? 'en' : 'sq'} aria-label={t(lang, 'admin.lang.toggle.aria')}>{t(lang, 'admin.lang.toggle')}</button>
      </div>
      <p class="fld__help">{t(lang, 'admin.login.forgot')}</p>
    </form>
  </div>
  <script>
    import '../../scripts/admin/login';
  </script>
</Admin>
