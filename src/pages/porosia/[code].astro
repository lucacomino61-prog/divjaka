---
import Order from '../../views/Order.astro';
import NotFound from '../../views/NotFound.astro';
import { load } from '../../views/order.load';

const params = { code: Astro.params.code ?? '' };
const data = await load(params, 'sq');
if (!data) Astro.response.status = 404;
---
{data ? <Order lang="sq" params={params} data={data} /> : <NotFound lang="sq" />}
