---
/**
 * ItineraryCta — "08 · Itinerari": the way into the planner (T7) as a quiet salt sheet (the
 * footer below is the ink sheet). No poster word: on the home only the wordmark and the chart are
 * loud (DESIGN §4). No sample route is drawn: a route on the chart is only ever one the visitor plans.
 */
import Pill from '../site/Pill.astro';
import { t } from '../../i18n/ui';
import { path, type Lang } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="itin" aria-labelledby="itin-h">
  <div class="wrap itin__inner">
    <p class="itin__rule mono"><span>{t(lang, 'home.itin.index')}</span><span>{t(lang, 'home.itin.kicker')}</span></p>
    <div class="itin__row">
      <h2 id="itin-h" class="itin__title heading">{t(lang, 'home.itin.title')}</h2>
      <p class="itin__body">{t(lang, 'home.itin.body')}</p>
      <div class="itin__cta"><Pill href={path('itinerary', lang)} arrow>{t(lang, 'home.itin.cta')}</Pill></div>
    </div>
  </div>
</section>

<style>
  .itin { padding-block: 0; position: relative; }
  .itin__inner { position: relative; }
  .itin__rule { display: flex; gap: 14px; font-size: var(--step--2); padding-block-start: 10px; border-block-start: 3px double var(--ink); }
  .itin__row { display: grid; gap: 18px; align-items: end; margin-block-start: clamp(20px, 3vw, 40px); }
  .itin__title { text-wrap: balance; }
  .itin__body { max-inline-size: 46ch; color: var(--muted); }
  @media (min-width: 900px) { .itin__row { grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr); } .itin__cta { justify-self: end; } }
</style>
