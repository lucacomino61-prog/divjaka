---
/**
 * Signature — "Laguna vizatohet" (DESIGN §4). Server: the finished chart with five numbered
 * stops + a ruled list of the stops (the whole content, words in the HTML). With motion on
 * (html.js, no Stop, no reduced motion) CSS turns the section into a tall track with a
 * sticky stage and src/scripts/chart-signature.ts scrubs one timeline over it: the coast draws
 * north → south, the lagoon closes, waterlines follow, the water label letters itself, then the
 * camera (a transform on the chart group) visits the five stops — pin, ripple, leader, a card
 * dealt from the right (bottom sheet on phones) — and zooms out to all pins. "Shiko si listë"
 * and "Kalo hartën" are always at hand. Motion off / JS off: chart + list, nothing pinned.
 */
import Chart from '../chart/Chart.astro';
import Photo from '../site/Photo.astro';
import Pill from '../site/Pill.astro';
import Stamp from '../site/Stamp.astro';
import SourceList from '../site/SourceList.astro';
import { stops as getStops } from './stops';
import { SHEET_CROP } from '../chart/geo';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const stops = getStops(lang);
const total = String(stops.length).padStart(2, '0');
const [, , cw, ch] = SHEET_CROP;
// route legs: hotel → forest → tower → lagoon (never to the closed island)
const legs = stops.filter((s) => !s.closed).map((s) => s.poi);
const pins = stops.map((s) => ({ id: s.poi, key: `stop-${s.key}`, n: s.n, label: s.name, tag: 'both' as const, zone: s.closed, side: s.side }));
const data = stops.map((s) => ({ key: s.key, x: s.x, y: s.y, r: s.r, closed: s.closed }));
const allSources = stops.flatMap((s) => s.sources);
---
<section class="sig" id="harta" aria-labelledby="harta-h" data-sig data-stops={JSON.stringify(data)} style={`--ar:${(cw / ch).toFixed(4)}`}>
  <div class="sig__track" data-sig-track>
    <div class="sig__stage" data-sig-stage>
      <div class="sig__intro" data-sig-intro>
        <p class="sig__rule mono"><span>{t(lang, 'home.sig.index')}</span><span>{t(lang, 'home.sig.kicker')}</span></p>
        <h2 id="harta-h" class="sig__title">{t(lang, 'home.sig.title')}</h2>
        <p class="sig__lead">{t(lang, 'home.sig.lead')}</p>
        <p class="sig__skips">
          <a href="#harta-liste" class="sig__link mono" data-sig-list-open aria-controls="harta-liste">{t(lang, 'home.sig.list')}</a>
          <a href="#pas-hartes" class="sig__link mono" data-sig-skip>{t(lang, 'home.sig.skip')} ↓</a>
        </p>
        <p class="sig__hint mono" aria-hidden="true"><span class="sig__hint-line"></span>{t(lang, 'home.sig.hint')}</p>
      </div>

      <div class="sig__chart">
        <Chart lang={lang} mode="signature" pins={pins} route={legs} routeTone="ink" crop={SHEET_CROP} title={`${t(lang, 'chart.title')}: ${stops.map((s) => `${s.n} ${s.name}`).join(', ')}`} />
      </div>

      <ol class="sig__cards" data-sig-cards aria-label={t(lang, 'home.sig.list.title')}>
        {stops.map((s, i) => (
          <li class:list={['sig-card', s.closed && 'sig-card--closed']} data-card={i}>
            <div class="sig-card__plate">
              <Photo slug={s.photo} lang={lang} ratio="3 / 2" sizes="(min-width: 900px) 400px, 112px" crosshair={false} />
            </div>
            <div class="sig-card__body">
              <p class="sig-card__meta mono"><span>{s.n} / {total}</span><span>{s.kicker}</span></p>
              <h3 class="sig-card__name">{s.name}</h3>
              <p class="sig-card__text">{s.text}</p>
              <p class="sig-card__dist mono">
                {s.distance}{s.key !== 'hotel' && <span class="muted"> · {t(lang, 'home.sig.crow')}</span>}{s.approx && <span class="muted"> · {t(lang, 'home.sig.approx')}</span>}
              </p>
              <p class="sig-card__src mono">
                {t(lang, 'home.sig.source')}: {s.sources.map((src, j) => <Fragment>{j > 0 && ' · '}<a href={src.url} rel="noopener">{src.publisher}</a></Fragment>)}
              </p>
              <div class="sig-card__cta">
                {s.closed && <Stamp kind="closed" lang={lang} />}
                <Pill href={s.cta.href} size="s" variant={s.closed ? 'outline' : 'primary'} arrow>{s.cta.label}</Pill>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <div class="sig__end" data-sig-end>
        <p class="sig__rule mono"><span>{total}</span><span>{t(lang, 'home.sig.kicker')}</span></p>
        <p class="sig__end-title">{t(lang, 'home.sig.end.title')}</p>
        <p class="sig__end-body">{t(lang, 'home.sig.end.body')}</p>
        <p class="sig__skips">
          <button type="button" class="pill pill--outline pill--s" data-sig-list-open aria-controls="harta-liste" aria-expanded="false"><span class="pill__main">{t(lang, 'home.sig.list')}</span></button>
          <a href="#pas-hartes" class="sig__link mono" data-sig-skip>{t(lang, 'home.sig.skip')} ↓</a>
        </p>
      </div>

      <p class="sig__progress mono" aria-hidden="true"><span data-sig-count>00</span> / {total}<span class="sig__bar"><span data-sig-bar></span></span></p>
    </div>
  </div>

  <div class="sig__list wrap" id="harta-liste" data-sig-list tabindex="-1">
    <h3 class="sig__list-title mono">{t(lang, 'home.sig.list.title')}</h3>
    <ol class="sig-list">
      {stops.map((s) => (
        <li class="sig-list__row">
          <span class="sig-list__n mono">{s.n}</span>
          <div class="sig-list__plate"><Photo slug={s.photo} lang={lang} ratio="1 / 1" sizes="96px" crosshair={false} /></div>
          <div class="sig-list__main">
            <p class="sig-list__kicker mono">{s.kicker}</p>
            <h4 class="sig-list__name">{s.name}</h4>
            <p class="sig-list__text">{s.text}</p>
            <p class="sig-list__src mono">{t(lang, 'home.sig.source')}: {s.sources.map((src, j) => <Fragment>{j > 0 && ' · '}<a href={src.url} rel="noopener">{src.publisher}</a></Fragment>)}</p>
          </div>
          <p class="sig-list__dist mono">{s.distance}{s.approx && <><br /><span class="muted">{t(lang, 'home.sig.approx')}</span></>}</p>
          <div class="sig-list__cta">
            {s.closed && <Stamp kind="closed" lang={lang} />}
            <Pill href={s.cta.href} size="s" variant="outline" arrow>{s.cta.label}</Pill>
          </div>
        </li>
      ))}
    </ol>
    <SourceList lang={lang} items={allSources} title={t(lang, 'home.sig.sources')} id="harta-burimet" />
  </div>
  <span id="pas-hartes" class="sig__after" tabindex="-1"></span>
</section>

<style>
  .sig { position: relative; --sig-pad: var(--page-pad); }
  .sig__track { position: relative; }
  .sig__stage { position: relative; display: grid; gap: clamp(20px, 3vw, 40px); padding: var(--section-gap) var(--sig-pad) 32px; max-inline-size: var(--page-max); margin-inline: auto; }
  .sig__rule { display: flex; gap: 14px; font-size: var(--step--2); padding-block-start: 10px; border-block-start: 2px solid var(--ink); }
  .sig__title {
    font-family: var(--font-poster); font-weight: 800; font-stretch: 75%; font-variation-settings: "opsz" 96;
    text-transform: uppercase; letter-spacing: -0.03em; line-height: 0.86;
    font-size: clamp(3rem, 1.4rem + 6.4vw, 7.5rem); margin-block: 16px 18px; overflow-wrap: anywhere; text-wrap: balance;
  }
  .sig__lead { font-size: var(--step-1); line-height: 1.35; max-inline-size: 34ch; font-stretch: 92%; }
  .sig__skips { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; margin-block-start: 22px; }
  .sig__link { display: inline-flex; align-items: center; min-block-size: 44px; font-size: var(--step--1); text-underline-offset: 5px; }
  .sig__hint { display: none; }
  .sig__intro:focus-within { opacity: 1 !important; }
  .sig__cards, .sig__end, .sig__progress { display: none; }
  .sig__chart { min-inline-size: 0; }
  .sig__chart :global(.chart__box) { inline-size: min(100%, calc(78svh * var(--ar))); margin-inline: auto; }
  .sig__chart :global(.cpin__name) { display: none; }
  @media (min-width: 900px) {
    .sig__stage { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; }
    .sig__intro { position: sticky; inset-block-start: calc(var(--header-h) + 32px); }
  }

  /* ---------- the list (always in the HTML; under the chart when motion is off) ---------- */
  .sig__list { padding-block: 8px var(--section-gap); outline: none; }
  .sig__list-title { font-size: var(--step--2); padding-block: 10px; border-block-start: 3px double var(--ink); }
  .sig-list { list-style: none; margin: 0; padding: 0; }
  .sig-list__row {
    display: grid; gap: 8px 18px; padding-block: 18px; border-block-end: 1px solid var(--rule);
    grid-template-columns: 2.4em 72px minmax(0, 1fr);
    grid-template-areas: "n plate main" "n plate dist" "n plate cta";
    align-items: start;
  }
  .sig-list__n { grid-area: n; font-size: var(--step--1); padding-block-start: 4px; }
  .sig-list__plate { grid-area: plate; }
  .sig-list__plate :global(.plate__caption) { display: none; }
  .sig-list__main { grid-area: main; min-inline-size: 0; }
  .sig-list__kicker { font-size: var(--step--2); color: var(--muted); }
  .sig-list__name { font-size: var(--step-2); font-weight: 700; font-stretch: 85%; line-height: 1.05; margin-block: 4px 6px; }
  .sig-list__text { max-inline-size: 60ch; }
  .sig-list__src { font-size: var(--step--2); color: var(--muted); margin-block-start: 6px; }
  .sig-list__src a { color: inherit; }
  .sig-list__dist { grid-area: dist; font-size: var(--step--1); }
  .sig-list__cta { grid-area: cta; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  @media (min-width: 900px) {
    .sig-list__row { grid-template-columns: 3em 96px minmax(0, 1fr) 12em minmax(0, 15em); grid-template-areas: "n plate main dist cta"; align-items: center; }
    .sig-list__cta { justify-content: flex-end; }
  }

  /* ---------- live mode: tall track, sticky stage, camera (motion on only) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not([data-motion="off"])) .sig__track { block-size: 520vh; }
    :global(html.js:not([data-motion="off"])) .sig__stage {
      display: block; position: sticky; inset-block-start: var(--header-h);
      block-size: calc(100svh - var(--header-h)); max-inline-size: none; padding: 0; overflow: clip;
      border-block: 1px solid var(--ink-12); background: var(--salt); isolation: isolate;
    }
    :global(html.js:not([data-motion="off"])) .sig__chart { position: absolute; inset: 0; display: grid; place-items: center; z-index: 0; }
    :global(html.js:not([data-motion="off"])) .sig__chart :global(.chart) { position: static; inline-size: 100%; block-size: 100%; display: grid; place-items: center; }
    :global(html.js:not([data-motion="off"])) .sig__chart :global(.chart__box) { inline-size: min(100%, calc((100svh - var(--header-h)) * var(--ar))); }
    :global(html.js:not([data-motion="off"])) .sig__chart :global(.chart__svg) { overflow: visible; }
    :global(html.js:not([data-motion="off"])) .sig__chart :global(.chart__foot) { position: absolute; inset-inline-start: var(--sig-pad); inset-block-end: 14px; z-index: 3; background: var(--salt); padding: 4px 8px 4px 0; }
    :global(html.js:not([data-motion="off"])) .sig__chart :global(.chart__osm) { margin-inline-start: 0; }
    :global(html.js:not([data-motion="off"])) .sig__chart :global(.cpin.is-active .cpin__name) { display: inline; }
    :global(html.js:not([data-motion="off"])) .sig__chart :global(.cpin__tag) { will-change: clip-path; }
    :global(html.js:not([data-motion="off"])) .sig__intro {
      position: absolute; z-index: 2; inset-block: 0; margin-block: auto; block-size: fit-content; inset-inline-start: var(--sig-pad);
      inline-size: min(36vw, 480px); background: var(--salt); box-shadow: 0 0 0 18px var(--salt);
    }
    :global(html.js:not([data-motion="off"])) .sig__hint { display: flex; align-items: center; gap: 12px; margin-block-start: 28px; font-size: var(--step--2); color: var(--muted); }
    :global(html.js:not([data-motion="off"])) .sig__hint-line { inline-size: 48px; block-size: 1px; background: currentColor; }
    :global(html.js:not([data-motion="off"])) .sig__cards { display: block; list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; z-index: 4; pointer-events: none; }
    :global(html.js:not([data-motion="off"])) .sig-card {
      position: absolute; inset-inline-end: var(--sig-pad); inset-block: 0; margin-block: auto; block-size: fit-content; max-block-size: calc(100% - 32px);
      inline-size: min(400px, 32vw); background: var(--salt); border: 1px solid var(--ink);
      visibility: hidden; opacity: 0; pointer-events: auto;
    }
    :global(html.js:not([data-motion="off"])) .sig__end {
      display: block; position: absolute; z-index: 2; inset-inline-start: var(--sig-pad); inset-block: 0; margin-block: auto; block-size: fit-content;
      inline-size: min(34vw, 440px); visibility: hidden; opacity: 0; background: var(--salt); box-shadow: 0 0 0 18px var(--salt);
    }
    :global(html.js:not([data-motion="off"])) .sig__progress {
      display: flex; align-items: center; gap: 10px; position: absolute; z-index: 3;
      inset-block-start: 14px; inset-inline-end: var(--sig-pad); font-size: var(--step--2); background: var(--salt); padding: 2px 0 2px 8px;
    }
    :global(html.js:not([data-motion="off"])) .sig__list { padding-block-start: var(--section-gap); }
  }
  .sig-card__plate :global(.plate__caption--credit) { position: absolute; inset-block-start: 8px; inset-inline-end: 8px; }
  .sig-card__plate { position: relative; }
  .sig-card__body { padding: 16px 18px 18px; display: grid; gap: 8px; border-block-start: 3px double var(--ink); }
  .sig-card__meta { display: flex; justify-content: space-between; gap: 12px; font-size: var(--step--2); color: var(--muted); }
  .sig-card__name { font-size: var(--step-3); font-weight: 700; font-stretch: 85%; line-height: 1; letter-spacing: -0.02em; overflow-wrap: anywhere; }
  .sig-card__text { font-size: var(--step-0); line-height: 1.42; }
  .sig-card__dist { font-size: var(--step--1); }
  .sig-card__src { font-size: var(--step--2); color: var(--muted); }
  .sig-card__src a { color: inherit; }
  .sig-card__body { min-inline-size: 0; }
  .sig-card__cta :global(.pill) { max-inline-size: 100%; }
  .sig-card__cta :global(.pill__main) { white-space: normal; text-align: start; }
  .sig-card__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-block-start: 4px; }
  .sig__end-title { font-family: var(--font-poster); font-weight: 800; font-stretch: 75%; text-transform: uppercase; letter-spacing: -0.03em; line-height: 0.88; font-size: clamp(2.4rem, 1rem + 4.4vw, 5.5rem); margin-block: 14px; }
  .sig__end-body { max-inline-size: 34ch; }
  .sig__bar { display: block; inline-size: 72px; block-size: 1px; background: var(--ink-12); overflow: hidden; }
  .sig__bar span { display: block; block-size: 100%; background: var(--ink); transform-origin: 0 50%; transform: scaleX(0); }

  /* phones: intro on top, cards as a bottom sheet, the chart in between */
  @media (prefers-reduced-motion: no-preference) and (max-width: 899px) {
    :global(html.js:not([data-motion="off"])) .sig__track { block-size: 440vh; }
    :global(html.js:not([data-motion="off"])) .sig__intro { inset-block: 16px auto; margin: 0; inline-size: auto; inset-inline-end: var(--sig-pad); box-shadow: 0 0 0 12px var(--salt); }
    :global(html.js:not([data-motion="off"])) .sig__title { font-size: clamp(2.4rem, 1.2rem + 7vw, 4rem); margin-block: 10px 8px; }
    :global(html.js:not([data-motion="off"])) .sig__lead { font-size: var(--step-0); }
    :global(html.js:not([data-motion="off"])) .sig__skips { margin-block-start: 8px; }
    :global(html.js:not([data-motion="off"])) .sig__hint { margin-block-start: 8px; }
    :global(html.js:not([data-motion="off"])) .sig-card {
      inset-inline: 0; inset-block: auto 0; margin: 0; inline-size: auto;
      border-inline: 0; border-block-end: 0; max-block-size: 58%;
      display: grid; grid-template-columns: 112px minmax(0, 1fr); align-items: start;
    }
    :global(html.js:not([data-motion="off"])) .sig-card__plate { padding: 14px 0 0 var(--sig-pad); }
    :global(html.js:not([data-motion="off"])) .sig-card__plate :global(.plate__caption--credit) { display: none; }
    :global(html.js:not([data-motion="off"])) .sig-card__body { border-block-start: 0; padding: 14px var(--sig-pad) 16px 14px; gap: 6px; }
    /* while a stop's sheet is up, the fixed assistant pill steps aside (it would cover the CTA) */
    :global(html.sig-card-on .assistant-pill) { opacity: 0; visibility: hidden; transition: opacity 200ms var(--ease-out), visibility 0s linear 200ms; }
    :global(html.js:not([data-motion="off"])) .sig-card__meta { flex-direction: column; gap: 2px; }
    :global(html.js:not([data-motion="off"])) .sig__chart :global(.cpin__tag) { white-space: normal; inline-size: max-content; max-inline-size: 40vw; }
    :global(html.js:not([data-motion="off"])) .sig-card__name { font-size: var(--step-2); }
    :global(html.js:not([data-motion="off"])) .sig-card__text { font-size: 0.95rem; line-height: 1.38; }
    :global(html.js:not([data-motion="off"])) .sig-card::before { content: ""; position: absolute; inset-inline: 0; inset-block-start: 0; block-size: 3px; border-block: 1px solid var(--ink); }
    :global(html.js:not([data-motion="off"])) .sig__end { inset-block: 16px auto; margin: 0; inline-size: auto; inset-inline-end: var(--sig-pad); box-shadow: 0 0 0 12px var(--salt); }
    :global(html.js:not([data-motion="off"])) .sig__end-title { font-size: clamp(2rem, 1rem + 6vw, 3.4rem); }
    :global(html.js:not([data-motion="off"])) .sig__progress { inset-block-start: auto; inset-block-end: 14px; }
  }
  /* short phones (320×568): the sheet drops the plate and the kicker so the button stays on screen */
  @media (prefers-reduced-motion: no-preference) and (max-width: 899px) and (max-height: 720px) {
    :global(html.js:not([data-motion="off"])) .sig-card { grid-template-columns: minmax(0, 1fr); max-block-size: 72%; }
    :global(html.js:not([data-motion="off"])) .sig-card__plate { display: none; }
    :global(html.js:not([data-motion="off"])) .sig-card__body { padding-inline-start: var(--sig-pad); }
    :global(html.js:not([data-motion="off"])) .sig-card__meta span + span { display: none; }
    :global(html.js:not([data-motion="off"])) .sig-card__name { font-size: var(--step-1); }
  }
</style>

<script>
  import { initSignature } from '../../scripts/chart-signature';
  initSignature();
</script>
