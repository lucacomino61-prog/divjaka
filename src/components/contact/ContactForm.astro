---
/**
 * ContactForm — POSTs to the contact page itself (works without JavaScript; the view handles the
 * POST, see Contact.astro). scripts/contact.ts sends the same fields to POST /api/contact as JSON
 * with `elapsed_ms` for the time trap. Spam guards: a honeypot field (`website`, off-screen, not
 * focusable) and a time trap (`ts` = when the form was rendered; under 2.5 s is a script). Errors
 * sit next to their fields; what the visitor typed is kept on every error. Submit is never
 * disabled before it is pressed.
 */
import { t } from '../../i18n/ui';
import { path, type Lang } from '../../i18n/routes';

export interface ContactValues { name: string; email: string; phone: string; subject: string; message: string }
interface Props { lang: Lang; values?: Partial<ContactValues>; errors?: Record<string, string>; formError?: string; sentName?: string | null }
const { lang, values = {}, errors = {}, formError, sentName } = Astro.props;
const subjects = ['booking', 'group', 'order', 'park', 'privacy', 'other'];
const ts = String(Date.now());
const v = (k: keyof ContactValues) => values[k] ?? '';
---
<div class="cform" data-contact>
  <div class="cform__sent" data-sent hidden={!sentName} role="status" tabindex="-1">
    <p class="cform__sent-t">{t(lang, 'contact.form.sent.title')}</p>
    <p data-sent-body>{sentName ? t(lang, 'contact.form.sent.body', { name: sentName }) : ''}</p>
    <a class="pill pill--outline pill--s" href={`${path('contact', lang)}#shkruani`} data-again>{t(lang, 'contact.form.sent.again')}</a>
  </div>
  <form class="cform__form" method="post" action={`${path('contact', lang)}#shkruani`} novalidate data-contact-form hidden={!!sentName} aria-labelledby="cf-h">
    <h2 id="cf-h" class="cform__h">{t(lang, 'contact.form.title')}</h2>
    {(formError || Object.keys(errors).length > 0) && (
      <p class="cform__summary mono" role="alert" data-form-error>{formError ?? t(lang, 'contact.form.err.summary')}</p>
    )}
    {!(formError || Object.keys(errors).length > 0) && <p class="cform__summary mono" role="alert" data-form-error hidden></p>}
    <input type="hidden" name="lang" value={lang} />
    <input type="hidden" name="ts" value={ts} />
    <div class="cform__hp" aria-hidden="true">
      <label for="cf-website">{t(lang, 'contact.form.website')}</label>
      <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <div class="cform__grid">
      <div class="cfield cfield--full">
        <label for="cf-name" class="mono">{t(lang, 'contact.form.name')}</label>
        <input id="cf-name" name="name" autocomplete="name" maxlength="120" value={v('name')} aria-invalid={errors.name ? 'true' : undefined} aria-describedby="cf-name-err" />
        <p class="cfield__err mono" id="cf-name-err" data-err="name">{errors.name}</p>
      </div>
      <div class="cfield">
        <label for="cf-email" class="mono">{t(lang, 'contact.form.email')}</label>
        <input id="cf-email" name="email" type="email" inputmode="email" autocomplete="email" spellcheck="false" maxlength="200" value={v('email')} aria-invalid={errors.email ? 'true' : undefined} aria-describedby="cf-email-err cf-or" />
        <p class="cfield__err mono" id="cf-email-err" data-err="email">{errors.email}</p>
      </div>
      <div class="cfield">
        <label for="cf-phone" class="mono">{t(lang, 'contact.form.phone')}</label>
        <input id="cf-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="40" value={v('phone')} aria-describedby="cf-or" />
      </div>
      <p class="cfield__hint mono cfield--full" id="cf-or">{t(lang, 'contact.form.or')}</p>
      <div class="cfield cfield--full">
        <label for="cf-subject" class="mono">{t(lang, 'contact.form.subject')}</label>
        <select id="cf-subject" name="subject">
          <option value="">{t(lang, 'contact.form.subject.none')}</option>
          {subjects.map((s) => <option value={s} selected={v('subject') === s}>{t(lang, `contact.form.subject.${s}`)}</option>)}
        </select>
      </div>
      <div class="cfield cfield--full">
        <label for="cf-message" class="mono">{t(lang, 'contact.form.message')}</label>
        <textarea id="cf-message" name="message" rows="6" maxlength="5000" placeholder={t(lang, 'contact.form.message.placeholder')} aria-invalid={errors.message ? 'true' : undefined} aria-describedby="cf-message-err">{v('message')}</textarea>
        <p class="cfield__err mono" id="cf-message-err" data-err="message">{errors.message}</p>
      </div>
    </div>
    <p class="cform__consent">{t(lang, 'contact.form.consent')} <a href={path('privacy', lang)}>{t(lang, 'contact.form.consent.link')}</a></p>
    <button type="submit" class="pill pill--primary cform__send"><span class="pill__main" data-send-label>{t(lang, 'contact.form.send')}</span></button>
  </form>
</div>

<style>
  .cform { display: grid; gap: 16px; }
  .cform__form { display: grid; gap: 18px; }
  .cform__form[hidden] { display: none; }
  .cform__h { font-size: var(--step-3); font-weight: 700; font-stretch: 85%; line-height: 1; }
  .cform__summary { font-size: var(--step--1); color: var(--pouch-text); padding-block: 10px; border-block: 1px solid var(--pouch); }
  .cform__hp { position: absolute; inset-inline-start: -10000px; inset-block-start: auto; inline-size: 240px; }
  .cform__hp input { inline-size: 200px; block-size: 48px; }
  .cform__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 20px; }
  .cfield { display: grid; gap: 6px; align-content: start; min-inline-size: 0; }
  .cfield--full { grid-column: 1 / -1; }
  .cfield label { font-size: var(--step--2); }
  .cfield input, .cfield textarea, .cfield select { inline-size: 100%; min-block-size: 48px; padding: 10px 12px; font: inherit; font-size: 16px; background: var(--salt); color: var(--ink); border: 0; border-block-end: 1px solid var(--ink); border-radius: 0; }
  .cfield select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%), linear-gradient(135deg, var(--ink) 50%, transparent 50%); background-position: calc(100% - 18px) 50%, calc(100% - 13px) 50%; background-size: 5px 5px; background-repeat: no-repeat; padding-inline-end: 36px; }
  .cfield textarea { resize: vertical; line-height: 1.5; }
  .cfield :is(input, textarea, select):focus-visible { outline: 2px solid var(--pouch); outline-offset: 2px; }
  .cfield [aria-invalid="true"] { border-block-end: 2px solid var(--pouch); }
  .cfield__err { font-size: var(--step--2); color: var(--pouch-text); }
  .cfield__err:empty { display: none; }
  .cfield__hint { font-size: var(--step--2); color: var(--muted); margin-block-start: -8px; }
  .cform__consent { font-size: var(--step--1); color: var(--muted); max-inline-size: 60ch; }
  .cform__consent a { display: inline-flex; align-items: center; justify-content: center; min-block-size: 24px; min-inline-size: 24px; }
  /* phones: a full 44 px square even for the short English "Privacy" (42 px wide on its own) */
  @media (pointer: coarse) { .cform__consent a { min-block-size: 44px; min-inline-size: 44px; } }
  .cform__send { justify-self: start; }
  .cform__sent { display: grid; gap: 12px; justify-items: start; padding: 24px; border: 1px solid var(--ink); border-block-start: 3px double var(--ink); }
  .cform__sent[hidden] { display: none; }
  .cform__sent:focus { outline: none; }
  .cform__sent-t { font-size: var(--step-3); font-weight: 700; font-stretch: 85%; }
  @media (max-width: 520px) { .cform__grid { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  import { initContact } from '../../scripts/contact';
  initContact();
</script>
