---
/**
 * ShareRow — WhatsApp · Viber · Facebook · Copy link (+ the browser's own share sheet where it
 * exists). Server-rendered links with utm_source=share&utm_medium=<channel>, so they work without
 * JavaScript; scripts/share.ts adds the share sheet, the copy and the 'share' events.
 *   <ShareRow lang={lang} url={canonical} title={name} kind="goods" product={slug} />
 */
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/routes';

interface Props { lang: Lang; url: string; title: string; kind?: string; product?: string; class?: string }
const { lang, url, title, kind = 'page', product, class: cls } = Astro.props;
const text = t(lang, 'share.text', { name: title });
const tagged = (channel: string) => {
  const u = new URL(url);
  u.searchParams.set('utm_source', 'share');
  u.searchParams.set('utm_medium', channel);
  return u.href;
};
const links = [
  { channel: 'whatsapp', label: t(lang, 'share.whatsapp'), href: `https://wa.me/?text=${encodeURIComponent(`${text} ${tagged('whatsapp')}`)}` },
  { channel: 'viber', label: t(lang, 'share.viber'), href: `viber://forward?text=${encodeURIComponent(`${text} ${tagged('viber')}`)}` },
  { channel: 'facebook', label: t(lang, 'share.facebook'), href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(tagged('facebook'))}` },
];
---
<div class:list={['share', cls]} data-share data-url={url} data-title={title} data-text={text} data-kind={kind} data-product={product}>
  <p class="share__title mono">{t(lang, 'share.title')}</p>
  <ul class="share__list">
    <li><button type="button" class="share__btn" data-share-native hidden>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 10V2M5 5l3-3 3 3M3 8v6h10V8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>{t(lang, 'share.native')}</button></li>
    {links.map((l) => (
      <li><a class="share__btn" href={l.href} rel="noopener noreferrer" target="_blank" data-share-channel={l.channel} aria-label={t(lang, 'share.aria', { channel: l.label })}>{l.label}</a></li>
    ))}
    <li><button type="button" class="share__btn" data-share-copy>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M6 10l4-4M7 4.5l1.5-1.5a2.5 2.5 0 0 1 3.5 3.5L10.5 8M9 11.5 7.5 13A2.5 2.5 0 0 1 4 9.5L5.5 8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      <span class="share__copy-label">{t(lang, 'share.copy')}</span><svg class="share__copy-done" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button></li>
  </ul>
  <input class="share__field mono" type="text" readonly value={tagged('copy')} aria-label={t(lang, 'share.copy')} data-share-field hidden />
  <p class="visually-hidden" role="status" aria-live="polite" data-share-status></p>
</div>

<style>
  .share { display: grid; gap: 10px; }
  .share__title { font-size: var(--step--2); color: var(--muted); }
  .share__list { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .share__btn {
    display: inline-flex; align-items: center; gap: 8px; min-block-size: 44px; padding: 0 16px;
    border: 1px solid var(--ink); border-radius: var(--radius-pill); background: transparent; color: var(--ink);
    font: inherit; font-family: var(--font-mono); font-size: var(--step--2); text-transform: uppercase; letter-spacing: .06em;
    text-decoration: none; cursor: pointer; touch-action: manipulation;
    transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .share__btn[hidden] { display: none; }
  .share__btn:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .share__btn:hover { background: var(--ink); color: var(--salt); } }
  .share__copy-done { display: none; }
  .share__btn[data-state="done"] .share__copy-done { display: inline; }
  .share__field { inline-size: 100%; min-block-size: 44px; font-size: 16px; padding: 0 10px; border: 1px solid var(--ink); background: var(--salt-2); color: var(--ink); }
  .share__field[hidden] { display: none; }
</style>
