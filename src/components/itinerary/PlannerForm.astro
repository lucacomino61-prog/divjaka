---
/**
 * PlannerForm — the question sheet (DESIGN §6 Itinerary). A plain GET form to the same page:
 * without JavaScript the server reads the query and renders the plan. Choices are radio and
 * checkbox chips (one generous hit target per label); scripts/itinerary.ts only tidies the URL
 * (interesa=a,b) and tracks the step.
 */
import type { PlanInput } from './engine';
import { horizonDays } from './engine';
import { INTEREST_VALUE, type Interest } from './places';
import { t } from '../../i18n/ui';
import { addDays } from '../../i18n/format';
import { path, type Lang } from '../../i18n/routes';
import { tirane } from '../../lib/time';

interface Props { lang: Lang; input: PlanInput; submitted: boolean }
const { lang, input, submitted } = Astro.props;
const today = tirane().date;
const interests: Interest[] = ['birds', 'nature', 'beach', 'culture', 'food', 'active'];
const paces = [['qete', 'slow'], ['normal', 'normal'], ['plot', 'full']] as const;
const moves = [['makine', 'car'], ['biciklete', 'bike'], ['kembe', 'foot']] as const;
---
<form class="pf" method="get" action={`${path('itinerary', lang)}#plani`} data-planner-form aria-labelledby="pf-h">
  <h2 id="pf-h" class="pf__h mono">{t(lang, 'itinerary.form.title')}</h2>

  <fieldset class="pf__set">
    <legend class="pf__legend mono"><span>01</span>{t(lang, 'itinerary.days')}</legend>
    <div class="pf__chips pf__chips--days">
      {[1, 2, 3, 4].map((n) => (
        <label class="chip chip--big"><input type="radio" name="dite" value={n} checked={input.days === n} /><span>{n}</span></label>
      ))}
    </div>
  </fieldset>

  <div class="pf__row">
    <div class="pf__field">
      <label class="pf__legend mono" for="pf-date"><span>02</span>{t(lang, 'itinerary.arrival')}</label>
      <input id="pf-date" class="pf__input" type="date" name="mberritja" value={input.arrival ?? ''} min={today} max={addDays(today, horizonDays())} aria-describedby="pf-date-hint" />
      <p id="pf-date-hint" class="pf__hint">{t(lang, 'itinerary.arrival.hint')}</p>
    </div>
    <div class="pf__field pf__field--s">
      <label class="pf__legend mono" for="pf-people"><span>03</span>{t(lang, 'itinerary.people')}</label>
      <input id="pf-people" class="pf__input" type="number" name="persona" inputmode="numeric" min="1" max="10" value={input.people} />
    </div>
  </div>

  <fieldset class="pf__set">
    <legend class="pf__legend mono"><span>04</span>{t(lang, 'itinerary.interests')}</legend>
    <div class="pf__chips">
      {interests.map((i) => (
        <label class="filter-chip"><input type="checkbox" name="interesa" value={INTEREST_VALUE[i]} checked={input.interests.includes(i)} /><span>{t(lang, `itinerary.i.${i}`)}</span></label>
      ))}
    </div>
    <p class="pf__hint">{t(lang, 'itinerary.interests.hint')}</p>
  </fieldset>

  <fieldset class="pf__set">
    <legend class="pf__legend mono"><span>05</span>{t(lang, 'itinerary.pace')}</legend>
    <div class="pf__chips pf__chips--3">
      {paces.map(([v, k]) => (
        <label class="chip chip--sub"><input type="radio" name="ritmi" value={v} checked={input.pace === k} /><span>{t(lang, `itinerary.pace.${k}`)}<small class="mono">{t(lang, `itinerary.pace.${k}.sub`)}</small></span></label>
      ))}
    </div>
  </fieldset>

  <fieldset class="pf__set">
    <legend class="pf__legend mono"><span>06</span>{t(lang, 'itinerary.move')}</legend>
    <div class="pf__chips pf__chips--3">
      {moves.map(([v, k]) => (
        <label class="filter-chip"><input type="radio" name="levizja" value={v} checked={input.transport === k} /><span>{t(lang, `itinerary.move.${k}`)}</span></label>
      ))}
    </div>
  </fieldset>

  <label class="pf__check">
    <input type="checkbox" name="femije" value="1" checked={input.kids} />
    <span><strong>{t(lang, 'itinerary.kids')}</strong><span class="pf__hint">{t(lang, 'itinerary.kids.hint')}</span></span>
  </label>

  <button type="submit" class="pill pill--primary pill--block pf__go">
    <span class="pill__main">{submitted ? t(lang, 'itinerary.update') : t(lang, 'itinerary.submit')}<svg class="pill__arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></span>
  </button>
</form>

<style>
  .pf { display: grid; gap: 22px; padding-block-start: 10px; border-block-start: 3px double var(--ink); }
  .pf__h { font-size: var(--step--2); color: var(--muted); }
  .pf__set { border: 0; padding: 0; margin: 0; min-inline-size: 0; display: grid; gap: 10px; }
  .pf__legend { display: flex; gap: 12px; align-items: baseline; font-size: var(--step--2); padding: 0; }
  .pf__legend span { color: var(--muted); }
  .pf__row { display: grid; grid-template-columns: minmax(0, 1fr) 8.5em; gap: 16px; }
  .pf__field { display: grid; gap: 10px; align-content: start; min-inline-size: 0; }
  .pf__input { min-block-size: 48px; inline-size: 100%; padding: 0 12px; font-size: 16px; background: var(--salt); color: var(--ink); border: 0; border-block-end: 1px solid var(--ink); border-radius: 0; font-family: var(--font-mono); }
  .pf__input:focus-visible { outline: 2px solid var(--pouch); outline-offset: 2px; }
  .pf__hint { font-size: var(--step--1); color: var(--muted); line-height: 1.4; }
  .pf__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .pf__chips--3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .pf__chips--days { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .chip { position: relative; display: inline-flex; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .chip input { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .chip > span {
    display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 2px; inline-size: 100%;
    min-block-size: 44px; padding: 6px 16px; border: 1px solid var(--ink); border-radius: var(--radius-pill);
    font-weight: 600; font-stretch: 92%; text-align: center; line-height: 1.15; overflow-wrap: anywhere;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), transform var(--dur-press) var(--ease-out);
  }
  .chip:active > span { transform: scale(0.97); }
  .chip small { font-size: 0.6875rem; font-weight: 400; opacity: .8; text-transform: uppercase; letter-spacing: .04em; }
  .chip input:checked + span { background: var(--ink); color: var(--salt); }
  .chip input:focus-visible + span { outline: 2px solid var(--pouch); outline-offset: 3px; }
  .chip--big > span { font-family: var(--font-poster); font-weight: 800; font-stretch: 75%; font-size: var(--step-3); min-block-size: 64px; border-radius: 0; }
  .chip--sub > span { min-block-size: 56px; }
  @media (hover: hover) and (pointer: fine) { .chip:hover input:not(:checked) + span { background: var(--salt-2); } }
  .pf__check { position: relative; display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 12px; align-items: start; cursor: pointer; padding-block: 12px; border-block: 1px solid var(--rule); min-block-size: 44px; }
  /* the whole row is the hit target; the box is drawn by ::before */
  .pf__check input { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .pf__check::before { content: ""; inline-size: 22px; block-size: 22px; border: 1.5px solid var(--ink); margin-block-start: 1px; background: var(--salt) center / 14px no-repeat; }
  .pf__check:has(input:checked)::before { background-color: var(--ink); background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="%23EDEAE0" stroke-width="2"/></svg>'); }
  .pf__check:has(input:focus-visible)::before { outline: 2px solid var(--pouch); outline-offset: 3px; }
  .pf__check > span { display: grid; gap: 2px; }
  .pf__go { margin-block-start: 4px; }
  @media (max-width: 380px) { .pf__row { grid-template-columns: minmax(0, 1fr); } .pf__chips--3 { grid-template-columns: minmax(0, 1fr); } }
</style>
