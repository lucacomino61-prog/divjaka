---
/**
 * RecommendRail — "Rekomanduar për ju" (PLAN §1: automatic recommendations, personalised by
 * history and preferences). Server: the popular / in-season picks from lib/recommend.ts, words and
 * prices in the HTML. Client (scripts/recommend.ts): reads dv-prefs interests, dv-viewed and the
 * cart, asks GET /api/recommend and re-orders the cards, each with its reason ("Sipas interesave
 * tuaja", "Sipas atyre që patë së fundi", "Shkon bashkë me zgjedhjet tuaja", "Në stinë tani",
 * "Ndër më të kërkuarat"). Every published product is server-rendered once (a hidden pool), so a
 * personalised card has the same plate, credit and price markup as the first paint.
 * "Interesat e mia" opens a sheet of interest chips that writes dv-prefs.
 *
 * Props: lang · index? (section number, e.g. "04") · title? · lead? (false hides it) · limit? (4–8, default 6)
 *        kinds? (Kind[] filter) · exclude? (slugs, e.g. the product on screen) · prefs? (show the
 *        "Interesat e mia" button, default true) · id? (unique per page when there are two rails)
 *        class?
 */
import SectionHead from '../site/SectionHead.astro';
import Photo from '../site/Photo.astro';
import Price from '../site/Price.astro';
import { recommend, type Reason } from '../../lib/recommend';
import { listProducts, pname, type Kind, type Product } from '../../lib/db/repo/products';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/routes';
import { productUrl } from '../../lib/urls';

interface Props {
  lang: Lang; index?: string; title?: string; lead?: string | false; limit?: number;
  kinds?: Kind[]; exclude?: string[]; prefs?: boolean; id?: string; class?: string;
}
const { lang, index, title, lead, limit = 6, kinds = [], exclude = [], prefs = true, id = 'rekomanduar', class: cls } = Astro.props;
const lim = Math.min(8, Math.max(4, limit));
let first: { slug: string; reason: Reason }[] = [];
try { first = recommend({ lang, limit: lim, kinds, exclude }).map((r) => ({ slug: r.slug, reason: r.reason })); } catch { first = []; }
const all = listProducts().filter((p) => !exclude.includes(p.slug) && (!kinds.length || kinds.includes(p.kind)));
const bySlug = new Map(all.map((p) => [p.slug, p]));
const shown = first.map((f) => ({ p: bySlug.get(f.slug), reason: f.reason })).filter((x): x is { p: Product; reason: Reason } => !!x.p);
const pool = all.filter((p) => !shown.some((s) => s.p.slug === p.slug));
const INTERESTS = ['birds', 'nature', 'beach', 'culture', 'food', 'active', 'family', 'couple', 'slow'];
const sheetId = `${id}-interesat`;
const img = (p: Product) => p.images[0]?.slug ?? null;
const alt = (p: Product) => (lang === 'en' ? p.images[0]?.alt_en : p.images[0]?.alt_sq) ?? undefined;
---
<section class:list={['rec sheet', cls]} id={id} aria-labelledby={`${id}-h`} data-rec data-limit={lim} data-kinds={kinds.join(',')} data-exclude={exclude.join(',')}>
  <div class="wrap">
    <SectionHead id={`${id}-h`} index={index} kicker={t(lang, 'recommend.kicker')} title={title ?? t(lang, 'recommend.title')} size="heading">
      {prefs && (
        <button slot="aside" type="button" class="rec__prefs-btn" aria-controls={sheetId} aria-expanded="false" aria-haspopup="dialog" data-rec-prefs-open>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.4" /><circle cx="5" cy="4" r="1.6" fill="var(--salt)" stroke="currentColor" stroke-width="1.4" /><circle cx="11" cy="8" r="1.6" fill="var(--salt)" stroke="currentColor" stroke-width="1.4" /><circle cx="7" cy="12" r="1.6" fill="var(--salt)" stroke="currentColor" stroke-width="1.4" /></svg>
          <span data-rec-prefs-label>{t(lang, 'recommend.prefs.open')}</span>
        </button>
      )}
    </SectionHead>
    {lead !== false && <p class="rec__lead">{lead ?? t(lang, 'recommend.lead')}</p>}
    <p class="rec__status mono" data-rec-status role="status" aria-live="polite"></p>
    <ol class="rec__list" data-rec-list>
      {shown.map(({ p, reason }) => (
        <li class="rec-card" data-rec-card={p.slug} data-reason={reason}>
          <div class="rec-card__link">
            <Photo slug={img(p)} lang={lang} ratio="4 / 3" sizes="(min-width: 1100px) 22vw, (min-width: 640px) 45vw, 80vw" alt={alt(p)} crosshair={false} />
            <p class="rec-card__reason mono"><span class="rec-card__dot" aria-hidden="true"></span><span data-rec-reason>{t(lang, `recommend.reason.${reason}`)}</span></p>
            <h3 class="rec-card__name"><a href={productUrl(p.kind, p.slug, lang)} class="rec-card__a"><span class="rec-card__nm">{pname(p, lang)}</span></a></h3>
            <p class="rec-card__row mono">
              <span>{t(lang, `recommend.kind.${p.kind}`)}</span>
              <Price lek={p.price} lang={lang} from={p.kind === 'room' || p.kind === 'gift'} per={p.kind === 'room' ? 'night' : p.kind === 'experience' ? 'person' : null} />
            </p>
          </div>
        </li>
      ))}
    </ol>
    <ol hidden data-rec-pool>
      {pool.map((p) => (
        <li class="rec-card" data-rec-card={p.slug}>
          <div class="rec-card__link">
            <Photo slug={img(p)} lang={lang} ratio="4 / 3" sizes="(min-width: 1100px) 22vw, (min-width: 640px) 45vw, 80vw" alt={alt(p)} crosshair={false} />
            <p class="rec-card__reason mono"><span class="rec-card__dot" aria-hidden="true"></span><span data-rec-reason></span></p>
            <h3 class="rec-card__name"><a href={productUrl(p.kind, p.slug, lang)} class="rec-card__a"><span class="rec-card__nm">{pname(p, lang)}</span></a></h3>
            <p class="rec-card__row mono">
              <span>{t(lang, `recommend.kind.${p.kind}`)}</span>
              <Price lek={p.price} lang={lang} from={p.kind === 'room' || p.kind === 'gift'} per={p.kind === 'room' ? 'night' : p.kind === 'experience' ? 'person' : null} />
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>

  {prefs && (
    <dialog id={sheetId} class="rec-sheet" aria-labelledby={`${sheetId}-h`} data-rec-sheet>
      <div class="rec-sheet__inner">
        <div class="rec-sheet__head">
          <h2 id={`${sheetId}-h`} class="rec-sheet__title">{t(lang, 'recommend.prefs.title')}</h2>
          <button type="button" class="rec-sheet__close mono" data-rec-prefs-close>{t(lang, 'recommend.prefs.close')}</button>
        </div>
        <p class="rec-sheet__body">{t(lang, 'recommend.prefs.body')}</p>
        <div class="rec-sheet__chips" role="group" aria-labelledby={`${sheetId}-h`}>
          {INTERESTS.map((k) => (
            <button type="button" class="chip" aria-pressed="false" data-interest={k}>
              <span class="chip__box" aria-hidden="true"></span>{t(lang, `recommend.interest.${k}`)}
            </button>
          ))}
        </div>
        <div class="rec-sheet__foot">
          <button type="button" class="rec-sheet__clear mono" data-rec-prefs-clear>{t(lang, 'recommend.prefs.clear')}</button>
          <button type="button" class="pill pill--primary" data-rec-prefs-close><span class="pill__main">{t(lang, 'recommend.prefs.done')}</span></button>
        </div>
      </div>
    </dialog>
  )}
</section>

<style>
  .rec__lead { max-inline-size: 52ch; color: var(--muted); margin-block-start: 14px; }
  .rec__status { min-block-size: 1.4em; font-size: var(--step--2); color: var(--muted); margin-block: 10px 6px; }
  .rec__prefs-btn {
    display: inline-flex; align-items: center; gap: 8px; min-block-size: 36px; padding: 0 14px; margin-block: -6px;
    border: 1px solid var(--ink); border-radius: 99px; background: transparent; color: var(--ink);
    font-family: var(--font-mono); font-size: var(--step--2); text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer;
    transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out), transform 120ms var(--ease-out); touch-action: manipulation;
  }
  .rec__prefs-btn:active { transform: scale(0.97); }
  @media (pointer: coarse) { .rec__prefs-btn { min-block-size: 44px; margin-block: -10px; } }
  .rec__prefs-btn::before { content: ""; position: absolute; inset: -6px 0; }
  .rec__prefs-btn { position: relative; }
  @media (hover: hover) and (pointer: fine) { .rec__prefs-btn:hover { background: var(--ink); color: var(--salt); } }
  .rec__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 32px var(--gutter); grid-template-columns: minmax(0, 1fr); transition: opacity 200ms var(--ease-out); }
  .rec__list[aria-busy="true"] { opacity: 0.55; }
  @media (min-width: 640px) { .rec__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .rec__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .rec-card { border-block-start: 2px solid var(--ink); padding-block-start: 10px; }
  .rec-card__link { position: relative; display: grid; gap: 10px; }
  .rec-card__a { display: block; min-block-size: 44px; text-decoration: none; color: inherit; }
  .rec-card__a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .rec-card__link :global(.plate__credit) { position: relative; z-index: 2; }
  .rec-card__a:focus-visible { outline: none; box-shadow: none; }
  .rec-card__a:focus-visible::after { outline: 2px solid var(--pouch); outline-offset: 3px; }
  .rec-card__reason { display: flex; align-items: center; gap: 8px; font-size: var(--step--2); }
  .rec-card__dot { inline-size: 7px; block-size: 7px; border-radius: 99px; background: var(--ink); flex: none; }
  .rec-card[data-reason="interests"] .rec-card__dot, .rec-card[data-reason="together"] .rec-card__dot, .rec-card[data-reason="history"] .rec-card__dot { background: var(--pouch); }
  .rec-card__name { font-size: var(--step-1); font-weight: 700; font-stretch: 85%; line-height: 1.08; text-wrap: balance; }
  .rec-card__nm { display: inline-block; transition: transform 200ms var(--ease-out); }
  .rec-card__row { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; font-size: var(--step--2); padding-block-start: 8px; border-block-start: 1px solid var(--rule); }
  @media (hover: hover) and (pointer: fine) { .rec-card__link:hover .rec-card__nm { transform: translateX(6px); } }

  /* the interests sheet: a bottom sheet (swipe down / Esc / button to close) */
  .rec-sheet {
    position: fixed; inset: auto 0 0 0; margin: 0 auto; max-inline-size: min(760px, 100vw); inline-size: 100%;
    max-block-size: 86dvh; padding: 0; border: 0; border-block-start: 3px double var(--ink);
    background: var(--salt); color: var(--ink);
    transform: none; transition: transform 260ms var(--ease-out), display 260ms allow-discrete, overlay 260ms allow-discrete;
  }
  .rec-sheet:not([open]) { transform: translateY(100%); }
  @starting-style { .rec-sheet[open] { transform: translateY(100%); } }
  .rec-sheet::backdrop { background: color-mix(in oklch, var(--ink) 40%, transparent); transition: opacity 260ms var(--ease-out), display 260ms allow-discrete, overlay 260ms allow-discrete; }
  .rec-sheet:not([open])::backdrop { opacity: 0; }
  @starting-style { .rec-sheet[open]::backdrop { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .rec-sheet, .rec-sheet::backdrop { transition-duration: 0s; } }
  :global(html[data-motion="off"]) .rec-sheet, :global(html[data-motion="off"]) .rec-sheet::backdrop { transition-duration: 0s; }
  .rec-sheet__inner { display: grid; gap: 16px; padding: 20px var(--page-pad) calc(20px + env(safe-area-inset-bottom)); overscroll-behavior: contain; overflow: auto; max-block-size: 86dvh; }
  .rec-sheet__head { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .rec-sheet__title { font-size: var(--step-3); }
  .rec-sheet__close, .rec-sheet__clear { min-block-size: 44px; padding: 0 4px; background: none; border: 0; color: inherit; font-size: var(--step--1); text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .rec-sheet__body { color: var(--muted); max-inline-size: 52ch; }
  .rec-sheet__chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip {
    display: inline-flex; align-items: center; gap: 10px; min-block-size: 44px; padding: 0 18px 0 14px;
    border: 1px solid var(--ink); border-radius: 99px; background: transparent; color: var(--ink);
    font: inherit; font-size: var(--step-0); cursor: pointer; touch-action: manipulation;
    transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .chip:active { transform: scale(0.97); }
  .chip__box { inline-size: 12px; block-size: 12px; border: 1.5px solid currentColor; border-radius: 99px; flex: none; }
  .chip[aria-pressed="true"] { background: var(--ink); color: var(--salt); }
  .chip[aria-pressed="true"] .chip__box { background: var(--pouch); border-color: var(--pouch); }
  .rec-sheet__foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block-start: 12px; border-block-start: 1px solid var(--rule); }
</style>

<script>
  import { initRecommend } from '../../scripts/recommend';
  initRecommend();
</script>
