---
/**
 * Breadcrumbs — mono trail with BreadcrumbList JSON-LD. Items: [{ label, href? }]; the last
 * item is the current page (no link, aria-current). `origin` makes JSON-LD URLs absolute.
 *   <Breadcrumbs lang={lang} items={[{ label: 'Qëndrimi', href: path('stay', lang) }, { label: room.name }]} />
 */
import { t } from '../../i18n/ui';
import { path, type Lang } from '../../i18n/routes';
import { siteOriginOf } from './site-data';

interface Item { label: string; href?: string }
interface Props { lang: Lang; items: Item[]; home?: boolean; class?: string }
const { lang, items, home = true, class: cls } = Astro.props;
const trail: Item[] = [...(home ? [{ label: t(lang, 'nav.home'), href: path('home', lang) }] : []), ...items];
const origin = await siteOriginOf(Astro.url, Astro.site); // the canonical origin, same as Base.astro
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((it, i) => ({
    '@type': 'ListItem', position: i + 1, name: it.label,
    ...(it.href ? { item: new URL(it.href, origin).href } : { item: new URL(Astro.url.pathname, origin).href }),
  })),
};
---
<nav class:list={['crumbs mono', cls]} aria-label={t(lang, 'crumbs.label')}>
  <ol>
    {trail.map((it, i) => (
      <li>
        {it.href && i < trail.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
