---
/**
 * AssistantPill — the fixed "Pyet · 24/7" pill (shell). Clicking dispatches the cancelable
 * window event 'dv:assistant-open' (chrome.ts). T7's assistant panel listens and calls
 * preventDefault() to open itself; with no panel on the page the pill is a plain link to the
 * contact page, so nothing breaks. Hidden while the menu or cart drawer is open. On phones, while a
 * booking or buy pill is docked at the bottom, it folds into a 56 px round button beside that pill
 * (the icon below; the link keeps its aria-label), instead of stacking above it (chrome.css).
 */
import { t } from '../../i18n/ui';
import { path, type Lang } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<a class="assistant-pill pill pill--primary" href={path('contact', lang)} data-assistant-open="pill" aria-label={t(lang, 'assistant.aria')}>
  <svg class="assistant-pill__icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3.5 4.5h13v9h-7l-4 3v-3h-2z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
  <span class="live-dot" aria-hidden="true"></span>
  <span class="assistant-pill__label">{t(lang, 'assistant.pill')}</span>
  <span class="assistant-pill__hours mono" aria-hidden="true">· {t(lang, 'assistant.hours')}</span>
</a>
