{
  "name": "divjaka-smart-tourism",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Divjaka Smart Tourism Platform — Hotel Pelikan, Divjakë (Albanian first, English second)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --port 3800",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview --port 3801",
    "check": "astro check",
    "db:seed": "node scripts/seed.mjs",
    "db:demo": "node scripts/seed.mjs --reset --demo",
    "db:faq": "node scripts/seed-data/faq.mjs --sync",
    "test:api": "node --test --test-concurrency=1 \"tests/api/*.test.mjs\"",
    "wordmark": "node tools/wordmark.mjs",
    "icons": "node tools/icons.mjs",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "astro": "^7.4.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "opentype.js": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
