# Copy to .env (git-ignored) and fill in. Names only here - never commit values.
# Admin login (scripts/seed.mjs generates ADMIN_PASSWORD when it is missing; delete it after the first sign-in)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Card payments through POK (card stays off in production until these are set and payments.mode is 'live')
POK_KEY_ID=
POK_KEY_SECRET=
POK_MERCHANT_ID=
# production | staging
POK_ENV=
# Optional: the assistant uses Claude (claude-haiku-5-5) when this is set (daily cap in settings.assistant.daily_cap)
ANTHROPIC_API_KEY=
# Reverse proxy (README -> Deployment contract): 1 behind a proxy that appends X-Forwarded-For and sets X-Forwarded-Proto/Host
TRUST_PROXY=
# Number of appending proxies in front of the app (default 1 = take the rightmost X-Forwarded-For entry)
TRUST_PROXY_HOPS=
# Optional: a header the proxy overwrites with the client address instead (x-real-ip, cf-connecting-ip)
CLIENT_IP_HEADER=
# 0 only for a plain-http production test on a LAN address (production cookies are Secure by default)
COOKIE_SECURE=
# 1 enables the TEST card simulator in a production build. Never on a public site.
ALLOW_TEST_PAYMENTS=
# Test servers only: multiplies every rate limit (e.g. 50 for npm run test:api)
RATE_LIMIT_FACTOR=
# Live data (/tani/): an e-mail for the MET Norway User-Agent (their terms ask for a contact; else the confirmed business e-mail is used)
LIVE_CONTACT=
# Optional: Open-Meteo commercial API key (air quality, waves, UV); without it those fields stay hidden
OPEN_METEO_API_KEY=
# Optional overrides (defaults: data/divjaka.db, data/)
DIVJAKA_DB=
DIVJAKA_DATA=
